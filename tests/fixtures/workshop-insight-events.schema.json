{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workshop insight event (contract C6)",
  "description": "One attendee insight event on the existing C3a ingest envelope. See docs/workshop-insight-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attendee", "type", "occurred_at", "payload", "idempotency_key"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$",
      "description": "Control Tower run. Empty on the collect path — a deployed terminal is never told its run id, so the collector stamps it from the unit it polled. Must be a UUID on the push path, where nothing else can supply it."
    },
    "workspace_id": {"type": ["string", "null"]},
    "attendee": {
      "type": "string",
      "minLength": 1,
      "description": "The POOLED lab identity, not a real email. Control Tower resolves it via the roster."
    },
    "type": {
      "type": "string",
      "enum": [
        "workshop.signal",
        "discovery.record",
        "insight.summary",
        "attendee.identity",
        "app.manifest"
      ]
    },
    "occurred_at": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["type"],
        "properties": {"type": {"const": "workshop.signal"}}
      },
      "then": {
        "type": "object",
        "properties": {
          "idempotency_key": {"type": "string", "pattern": "^signal:.+$"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stats_schema_version", "signal"],
            "properties": {
              "stats_schema_version": {"type": "integer", "enum": [2, 3]},
              "final_capture_id": {"type": "string", "minLength": 1, "description": "Optional WT-02 closeout identifier; absent on ordinary rolling signals."},
              "phase": {"type": "string"},
              "minutes_building": {"type": "integer"},
              "agent_sessions": {"type": "integer"},
              "terminal_sessions": {"type": "integer"},
              "topics": {"type": "array", "items": {"type": "string"}},
              "code": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "projects": {"type": "integer"},
                  "commits": {"type": "integer"},
                  "files": {"type": "integer"},
                  "lines": {"type": "integer"}
                }
              },
              "resources": {"type": "object"},
              "errors": {"type": "integer"},
              "idle_seconds": {"type": ["integer", "null"]},
              "discovery_records": {"type": "integer"},
              "signal": {
                "type": "object",
                "additionalProperties": false,
                "required": ["engagement", "products", "shipped"],
                "properties": {
                  "engagement": {
                    "type": "string",
                    "enum": ["observer", "explorer", "builder"],
                    "description": "explorer is not a lesser category — an attendee who built nothing usually hit a wall, and the wall is the most valuable thing in a brief."
                  },
                  "primary_topic": {"type": ["string", "null"]},
                  "topic_hits": {"type": "object"},
                  "products": {"type": "array", "items": {"type": "string"}},
                  "resource_kinds": {"type": "array", "items": {"type": "string"}},
                  "shipped": {"type": "boolean"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["type"],
        "properties": {"type": {"const": "discovery.record"}}
      },
      "then": {
        "type": "object",
        "properties": {
          "idempotency_key": {"type": "string", "pattern": "^discovery:.+$"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "captured_at", "revision"],
            "description": "Every field beyond record_id/captured_at/revision is optional. A partial record is the normal case and must be stored.",
            "properties": {
              "record_id": {"type": "string", "minLength": 1},
              "captured_at": {"type": "string", "minLength": 1},
              "revision": {
                "type": "integer",
                "minimum": 1,
                "description": "Monotonic per record_id. Also the last segment of idempotency_key, so an update is a distinct event while a retried flush stays a duplicate."
              },
              "redacted_by_attendee": {
                "type": "boolean",
                "const": true,
                "description": "Present only on a withdrawal, where every content field is blank. One-way: the record must never be revived by a later revision."
              },
              "agent": {"type": "string"},
              "confidence": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "The agent's read of how firmly the attendee stated this. Distinguishes a customer commitment from an inference."
              },
              "session_intent": {
                "type": "string",
                "enum": ["business_problem", "evaluation", "learning", "fun"],
                "description": "Why they were building. Triage datum: it is what stops a Space Invaders session being worked as a lead. Qualified by confidence, so an inferred business_problem is not a stated one. Absent means unclassified (or an older Terminal build), never 'no purpose'."
              },
              "use_case_title": {"type": "string"},
              "use_case_summary": {"type": "string"},
              "goal": {"type": "string"},
              "current_stack": {"type": "array", "items": {"type": "string"}},
              "databricks_products": {"type": "array", "items": {"type": "string"}},
              "blockers": {"type": "array", "items": {"type": "string"}},
              "interest_signals": {"type": "array", "items": {"type": "string"}},
              "timeline": {"type": "string"},
              "industry": {"type": "string"},
              "redactions": {"type": "integer"}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["type"],
        "properties": {"type": {"const": "insight.summary"}}
      },
      "then": {
        "type": "object",
        "properties": {
          "idempotency_key": {"type": "string", "pattern": "^summary:.+$"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary_id", "generated_at", "generator", "headline", "revision"],
            "properties": {
              "summary_id": {"type": "string", "minLength": 1},
              "generated_at": {"type": "string", "minLength": 1},
              "revision": {
                "type": "integer",
                "minimum": 1,
                "description": "Monotonic per attendee and retained with its accepted envelope across restart. Rolling summary keys include the revision; final closeout keys instead identify one immutable capture generation. Replayed keys preserve their original revision and payload."
              },
              "generator": {
                "type": "string",
                "enum": ["llm", "extraction"],
                "description": "Must be surfaced wherever a summary is shown — an extraction summary is keyword-thin and must not read like a finding."
              },
              "model": {"type": ["string", "null"]},
              "final_capture_id": {"type": "string", "minLength": 1, "description": "Optional WT-02 closeout identifier; final extraction facts supplement the prior model narrative."},
              "prior_narrative": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sequence", "revision", "generator", "model", "raw_entry_sha256"],
                "properties": {
                  "sequence": {"type": "integer", "minimum": 1},
                  "revision": {"type": "integer", "minimum": 1},
                  "generator": {"type": "string", "const": "llm"},
                  "model": {"type": ["string", "null"]},
                  "raw_entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                },
                "description": "Optional pointer to the unchanged prior LLM envelope: hash of canonical {seq,event}, preserving narrative provenance alongside fresh final facts."
              },
              "phase": {
                "type": "string",
                "description": "Content phase at generation — any of intro/setup/build/wrap, or whatever the instance was left in for the teardown fallback. The summary rolls continuously, so an early phase means the run was young, not that a trigger was missed."
              },
              "headline": {"type": "string"},
              "what_they_built": {"type": "string"},
              "session_intent": {
                "type": "string",
                "enum": ["business_problem", "evaluation", "learning", "fun"],
                "description": "Same vocabulary as discovery.record, so the two can be read side by side in one brief. Only the llm generator sets it; extraction leaves it absent rather than guessing from keywords."
              },
              "use_cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title"],
                  "properties": {
                    "title": {"type": "string"},
                    "summary": {"type": "string"},
                    "products": {"type": "array", "items": {"type": "string"}},
                    "evidence": {"type": "string"}
                  }
                }
              },
              "blockers": {"type": "array", "items": {"type": "string"}},
              "products": {"type": "array", "items": {"type": "string"}},
              "artifacts": {
                "type": "array",
                "description": "Metadata only — never contents.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind"],
                  "properties": {
                    "kind": {"type": "string"},
                    "title": {"type": "string"},
                    "bytes": {"type": "integer"}
                  }
                }
              },
              "prompt_count": {"type": "integer"},
              "redactions": {"type": "integer"},
              "summary_schema_version": {"type": "integer", "enum": [2], "description": "Insight contract v2. Present only when WORKSHOP_INSIGHT_V2 is on; absent means v1."},
              "asks": {"type": "array", "maxItems": 12, "description": "Attendee's own words, verbatim (redacted) from a prompt, help message or the wizard answer. Chosen by index, never paraphrased.", "items": {"type": "object", "additionalProperties": false, "required": ["text", "kind", "source"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 280}, "kind": {"type": "string", "enum": ["business", "data", "how_to", "blocker", "ambition", "unclassified"], "description": "unclassified only in fallback mode."}, "source": {"type": "string", "enum": ["prompt", "help", "wizard"]}, "at": {"type": ["string", "null"]}}}},
              "framing": {"type": "string", "maxLength": 600, "description": "Model-written, third person. Llm generator only."},
              "approach": {"type": "string", "maxLength": 600, "description": "Llm generator only."},
              "pivots": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 200}},
              "systems_mentioned": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["name", "kind"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 80}, "kind": {"type": "string", "enum": ["source_system", "incumbent_tool", "competitor", "cloud", "other"]}}}},
              "attendee_background": {"type": "string", "enum": ["", "domain", "data", "developer", "exploring"], "description": "The wizard background enum. Never a title or a role; empty means not given."}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["type"],
        "properties": {"type": {"const": "attendee.identity"}}
      },
      "then": {
        "type": "object",
        "properties": {
          "idempotency_key": {"type": "string", "pattern": "^identity:.+$"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attendee", "names", "observed_at"],
            "description": "The only event that names a human rather than a pooled lab account. Gated on WORKSHOP_INSIGHT_CAPTURE like everything else here.",
            "properties": {
              "attendee": {"type": "string", "minLength": 1},
              "binding_source": {
                "type": "string",
                "enum": ["control-tower", "persisted", "self-bound", "unbound"],
                "description": "How this instance came to believe it belongs to the attendee. The names are evidence about exactly this."
              },
              "observed_at": {"type": "string", "minLength": 1},
              "names": {
                "type": "array",
                "description": "Append-only, oldest first. Two names is corroboration or two people — never a correction, which is why this is a list and not a full_name field.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "source"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1, "maxLength": 60},
                    "source": {
                      "type": "string",
                      "enum": ["wizard", "certificate"],
                      "description": "Not equivalent evidence: a name typed onto a certificate is a stronger claim than one typed into an optional field."
                    },
                    "captured_at": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"type": "object", "required": ["type"], "properties": {"type": {"const": "app.manifest"}}},
      "then": {
        "type": "object",
        "properties": {
          "idempotency_key": {"type": "string", "pattern": "^app-manifest:.+$"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest_schema_version", "project", "captured_at", "stack", "resources", "uc_tables", "products_evidenced", "screenshots"],
            "description": "Journal-only, not an insight row. A priority type: may use the reserved buffer headroom.",
            "properties": {
              "manifest_schema_version": {"type": "integer", "enum": [1]},
              "project": {"type": "string", "minLength": 1, "maxLength": 120},
              "app_name": {"type": ["string", "null"], "maxLength": 120},
              "url": {"type": ["string", "null"], "maxLength": 500},
              "revision": {"type": ["string", "null"], "maxLength": 64},
              "captured_at": {"type": "string", "minLength": 1},
              "stack": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 40}},
              "resources": {"type": "array", "maxItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "name", "source"], "properties": {"kind": {"type": "string", "enum": ["sql_warehouse", "serving_endpoint", "database", "genie_space", "job", "pipeline", "volume", "secret", "uc_securable", "vector_search_index", "other"]}, "name": {"type": ["string", "null"], "maxLength": 200}, "source": {"type": "string", "maxLength": 200}}}},
              "uc_tables": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["name", "source"], "properties": {"name": {"type": "string", "maxLength": 300}, "source": {"type": "string", "maxLength": 200}}}},
              "products_evidenced": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["product", "source"], "properties": {"product": {"type": "string", "maxLength": 80}, "source": {"type": "string", "maxLength": 200}}}},
              "screenshots": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["file", "sha256", "bytes", "captured_at", "scope", "label"], "properties": {"file": {"type": "string", "maxLength": 200}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}, "captured_at": {"type": "string", "minLength": 1}, "scope": {"type": "string", "enum": ["deployed", "local"]}, "label": {"type": "string", "maxLength": 40}, "url": {"type": ["string", "null"], "maxLength": 500}, "title": {"type": ["string", "null"], "maxLength": 200}}}}
            }
          }
        }
      }
    }
  ]
}
