#!/usr/bin/env bash
# workshop-design-gate — the visual half of "is this build done?".
#
# Runs the workshop-design-studio audit and quality gate over the current
# project. `databricks apps validate` proves the app compiles and runs; this
# proves it is actually usable and looks designed. An app can pass validate and
# still ship unreadable contrast, invisible focus rings, images with no alt
# text, or a layout that breaks on a phone.
#
# Exits non-zero when the gate is red. A red gate means the build is NOT done:
# fix it, do not report success, and do not offer Promote.
#
# Usage: workshop-design-gate [project-root]   (defaults to the current dir)
#
# Generated by the workshop terminal — do not edit.
set -uo pipefail

ROOT="${1:-$PWD}"

# Skills are symlinked into every harness directory regardless of which agent is
# running, so take whichever resolves first.
SKILL=""
for candidate in "$HOME/.claude/skills/workshop-design-studio" \
                 "$HOME/.codex/skills/workshop-design-studio"; do
  if [ -d "$candidate" ]; then
    SKILL="$candidate"
    break
  fi
done

if [ -z "$SKILL" ]; then
  echo "workshop-design-studio skill not found — skipping the visual gate." >&2
  exit 0
fi

mkdir -p "$ROOT/.design-studio"

# The audit writes its findings to both files below, so its stdout is a verbatim
# duplicate — discard it and show the readable version only when it matters.
python3 "$SKILL/scripts/audit_project.py" \
  --root "$ROOT" \
  --json "$ROOT/.design-studio/audit.json" \
  --markdown "$ROOT/.design-studio/audit.md" >/dev/null 2>&1 || true

python3 "$SKILL/scripts/quality_gate.py" \
  --root "$ROOT" \
  --config "$SKILL/templates/quality-gate.json"
status=$?

if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "Visual gate is red — this build is not finished." >&2
  echo "" >&2
  [ -f "$ROOT/.design-studio/audit.md" ] && cat "$ROOT/.design-studio/audit.md" >&2
fi

exit "$status"
