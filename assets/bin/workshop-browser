#!/usr/bin/env python3
"""See the app you built: real screenshots, real clicks, honest gaps (W3).

Generated by the workshop terminal, do not edit. The Workshop Terminal renders
the page in a prepared browser and saves PNGs in the project under
.workshop/evidence/. Open every screenshot with your own image tool before you
describe the page: a file name is not proof that you saw it.

    workshop-browser status
    workshop-browser inspect http://localhost:$DATABRICKS_APP_PORT [--phone|--both]
                     [--do click:"Log an outage"] [--do fill:'#title=Fallen line'] [--do press:Enter]
    workshop-browser inspect https://<your-app>.databricksapps.com --deployed [--do ...]

Local checks the render on this terminal. --deployed opens your Databricks App
signed in as the attendee. Use it when seeing the page helps; it is optional.

Exit status: 0 observed, 3 a verification gap (say it is unverified), 1 error.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import urllib.error
import urllib.request


def _project() -> str:
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=10)
        if top.returncode == 0 and top.stdout.strip():
            return top.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return os.getcwd()


def _call(path: str, body: dict, timeout: int) -> dict:
    email = os.environ.get("WORKSHOP_USER_EMAIL", "")
    capability_file = Path.home() / ".config/workshop/callback-capability"
    if not email or not capability_file.is_file():
        raise SystemExit("workshop-browser: run this inside a Workshop Terminal session")
    app = os.environ.get("WORKSHOP_APP_URL", "http://localhost:8000").rstrip("/")
    request = urllib.request.Request(
        app + path, method="POST", data=json.dumps({"email": email, **body}).encode(),
        headers={"Content-Type": "application/json",
                 "X-Workshop-Capability": capability_file.read_text().strip()})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace")[:400]
        raise SystemExit(f"workshop-browser: refused (HTTP {error.code}): {detail}")
    except (urllib.error.URLError, OSError) as error:
        raise SystemExit(f"workshop-browser: could not reach the Workshop Terminal ({error})")


def _gap(result: dict) -> int:
    gap = result.get("gap") or {}
    print(f"VERIFICATION GAP ({gap.get('code')}): {gap.get('detail')}")
    print("Recorded in the workflow record. Tell the attendee this is unverified; do not claim it works.")
    return 3


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="workshop-browser", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    inspect = sub.add_parser("inspect")
    inspect.add_argument("url")
    inspect.add_argument("--deployed", action="store_true")
    size = inspect.add_mutually_exclusive_group()
    size.add_argument("--phone", action="store_true")
    size.add_argument("--both", action="store_true")
    inspect.add_argument("--do", action="append", default=[], metavar="ACTION")
    args = parser.parse_args(argv)

    if args.command == "status":
        result = _call("/api/browser/status", {}, 30)
        print("Browser ready" + (f" ({result.get('version')})" if result.get("version") else "")
              if result.get("available") else f"No browser here: {result.get('reason')}")
        return 0 if result.get("available") else 3
    if args.command == "inspect":
        viewports = ["phone"] if args.phone else ["desktop", "phone"] if args.both else ["desktop"]
        result = _call("/api/browser/inspect", {
            "url": args.url, "scope": "deployed" if args.deployed else "local", "viewports": viewports,
            "actions": args.do, "project": _project()}, 300)
        if not result.get("ok"):
            return _gap(result)
        project = Path(_project())
        for shot in result.get("artifacts", []):
            note = ""
            if shot.get("action"):
                action = shot["action"]
                note = f" after {action.get('action')} → {action.get('result')}"
                if action.get("result") == "ok" and not action.get("visible_change"):
                    note += " (NOTHING VISIBLY CHANGED: the action may be dead)"
            print(f"{shot['viewport']:<7} {project / shot['path']}{note}")
        if result.get("console_errors"):
            print("Console errors: " + " | ".join(result["console_errors"][:5]))
        if result.get("document_status") and result["document_status"] >= 400:
            print(f"The page answered HTTP {result['document_status']}.")
        print("Open each screenshot with your image tool now and describe what you actually see.")
        return 0
    return 2

if __name__ == "__main__":
    raise SystemExit(main())
