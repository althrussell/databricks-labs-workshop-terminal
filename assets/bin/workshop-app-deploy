#!/usr/bin/env python3
"""Deploy one Databricks App and wait for the exact deployment to become live.

The executable has two front doors over the same controller:

* a small command-line interface for an agent or attendee; and
* a stdio MCP server exposing only ``deploy_databricks_app``.

It intentionally shells out to the supported Databricks CLI project deploy
pipeline.  Credentials never enter argv or MCP traffic: every CLI subprocess
re-reads the rotating ``[DEFAULT]`` profile in the attendee's private HOME.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable


TOOL_NAME = "deploy_databricks_app"
SERVER_NAME = "workshop-app-deploy"
SERVER_VERSION = "1"
DEFAULT_TIMEOUT_SECONDS = 20 * 60
MIN_TIMEOUT_SECONDS = 30
MAX_TIMEOUT_SECONDS = 60 * 60
DEFAULT_POLL_SECONDS = 2.0
# A just-created app's compute is often still STARTING; submitting then fails
# with UNAVAILABLE (29 Oct, P6, F-024). Wait this long for ACTIVE first.
COMPUTE_READY_TIMEOUT_SECONDS = 10 * 60
MAX_PROGRESS_CHARS = 320
MAX_LOG_BYTES = 1024 * 1024
MISSING_SUBMIT_STATUS_MESSAGE = (
    "Deploy submission worker exited without reporting status"
)
TERMINAL_PHASES = frozenset({"succeeded", "failed"})
TARGET_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")
TOKEN_RE = re.compile(
    r"(?i)(bearer\s+|token[=:]\s*|secret[=:]\s*)[A-Za-z0-9._~+/=-]{8,}"
)
DATABRICKS_TOKEN_RE = re.compile(r"\b(?:dapi|dkea)[A-Za-z0-9._-]{8,}\b")
JWT_RE = re.compile(r"\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b")
EMAIL_RE = re.compile(r"(?i)\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b")
# Lakebase (Autoscaling) is ``postgres``; the provisioned instance is ``database``.
LAKEBASE_RESOURCE_KEYS = ("postgres", "database")
LAKEBASE_ENDPOINT_ENV = "LAKEBASE_ENDPOINT"
APP_CONFIG_FILES = ("app.yml", "app.yaml")
ENV_ITEM_RE = re.compile(r"^(\s*)-(?:\s+(.*?))?\s*$")
ENV_KEY_RE = re.compile(r"^\s*(name|value|valueFrom|resource)\s*:\s*(.*?)\s*$")
# Models are called as the attendee (OBO), which needs this user-authorization scope on the App.
AI_GATEWAY_SCOPE = "ai-gateway"
GENIE_SCOPE = "genie"
# Every App gets both: model calls (ai-gateway) and Genie (genie), as the attendee. A missing scope
# breaks the App, while an extra consent line costs nothing in a disposable seat workspace.
REQUIRED_USER_SCOPES = (AI_GATEWAY_SCOPE, GENIE_SCOPE)
# A `key:` line in a bundle file, with the quoted or plain key in group 2.
YAML_KEY_RE = re.compile(r"^(\s*)(\"[^\"]+\"|'[^']+'|[A-Za-z0-9_.\-]+)\s*:(?:\s+(.*?))?\s*$")
# Code that reads the endpoint, so the app needs the app.yml entry. Other routes (PGHOST and a password) don't.
CODE_SUFFIXES = (".py", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".json")
# Code that reads LAKEBASE_ENDPOINT directly, or through AppKit's lakebase() plugin, which reads it for the app.
LAKEBASE_ENDPOINT_USES = ("LAKEBASE_ENDPOINT", "lakebase()", "@databricks/lakebase", "appkit.lakebase")
SCAN_SKIP_DIRS = frozenset({"node_modules", ".venv", "venv", "__pycache__", "dist", "build"})
# The deploy ships from .build when a project builds into it, so the scan reads it.
SCAN_KEPT_DOTDIRS = frozenset({".build"})
SCAN_MAX_FILES = 2000
SCAN_MAX_BYTES = 512 * 1024


class DeployError(RuntimeError):
    """A controlled, attendee-readable deploy refusal."""


class CliError(DeployError):
    def __init__(self, message: str, *, returncode: int | None = None):
        super().__init__(message)
        self.returncode = returncode


class LockWaitStopped(RuntimeError):
    def __init__(self, reason: str):
        super().__init__(reason)
        self.reason = reason


class ComputeWaitStopped(RuntimeError):
    """The deploy was cancelled while waiting for the app's compute; nothing was submitted."""

    def __init__(self, reason: str, app_name: str):
        super().__init__(reason)
        self.reason = reason
        self.app_name = app_name


def _safe_line(value: object) -> str:
    text = str(value).replace("\x00", " ").replace("\r", " ").strip()
    text = TOKEN_RE.sub(lambda match: f"{match.group(1)}[REDACTED]", text)
    text = DATABRICKS_TOKEN_RE.sub("[REDACTED_TOKEN]", text)
    text = JWT_RE.sub("[REDACTED_TOKEN]", text)
    text = EMAIL_RE.sub("[REDACTED_EMAIL]", text)
    return text[:MAX_PROGRESS_CHARS]


def _state_root(env: dict[str, str]) -> Path:
    configured = env.get("WORKSHOP_APP_DEPLOY_STATE_DIR", "").strip()
    if configured:
        return Path(configured).expanduser().resolve()
    return (Path(env["HOME"]) / ".config" / "workshop" / "app-deploy").resolve()


def _project_root(env: dict[str, str]) -> Path:
    configured = env.get("WORKSHOP_PROJECTS_ROOT", "").strip()
    if configured:
        return Path(configured).expanduser().resolve()
    return (Path(env["HOME"]) / "projects").resolve()


def resolve_project_path(raw: str, env: dict[str, str], cwd: Path | None = None) -> Path:
    root = _project_root(env)
    candidate = Path((raw or ".").strip()).expanduser()
    if not candidate.is_absolute():
        base = (cwd or Path.cwd()).resolve()
        candidate = (base / candidate).resolve()
        if not (candidate / "databricks.yml").is_file():
            candidate = (root / raw).resolve()
    else:
        candidate = candidate.resolve()
    try:
        candidate.relative_to(root)
    except ValueError as exc:
        raise DeployError(
            f"project_path must stay inside the workshop projects directory: {root}"
        ) from exc
    if not (candidate / "databricks.yml").is_file():
        raise DeployError(f"No databricks.yml found in {candidate}")
    return candidate


PROJECT_PATH_ALIASES = ("project_dir", "app_path")


def collapse_project_path_aliases(arguments: dict[str, Any]) -> dict[str, Any]:
    """Fold ``project_dir`` and ``app_path`` into ``project_path``.

    Agents reach for the other tools' names for the project directory. Any mix of the
    three is accepted when every value names the same directory after normalisation;
    if they disagree, the call is refused and the conflicting fields are named.
    """
    names = [name for name in ("project_path", *PROJECT_PATH_ALIASES) if name in arguments]
    if not names or names == ["project_path"]:
        return arguments

    def key(value: Any) -> Any:
        if isinstance(value, str) and value.strip():
            return os.path.normpath(value.strip())
        return repr(value)

    if len({key(arguments[name]) for name in names}) > 1:
        raise DeployError(
            "project_path, project_dir and app_path must name the same directory; "
            f"these disagree: {', '.join(names)}"
        )
    collapsed = {k: v for k, v in arguments.items() if k not in PROJECT_PATH_ALIASES}
    collapsed["project_path"] = arguments[names[0]]
    return collapsed


def normalize_target(value: str | None) -> str | None:
    """The bundle target the caller named, or None when none was given.

    An omitted or empty target is never sent: ``databricks`` then picks the bundle's own
    default target (``default: true``, the only target, or the implicit ``default``). A
    named target is validated and passed through unchanged; it is never remapped, so an
    undeclared name is reported by the CLI.
    """
    if value is None or not value.strip():
        return None
    target = value.strip()
    if not TARGET_RE.fullmatch(target):
        raise DeployError(
            "target must contain only letters, numbers, dot, underscore, or hyphen"
        )
    return target


def state_target_key(target: str | None) -> str:
    """The lock and state key. An omitted target keeps the key the tool used before targets were optional."""
    return target or "default"


def _same_target(state: dict[str, Any], target: str | None) -> bool:
    """Whether ``state`` was started for ``target``.

    Current records store ``target`` (``None`` when omitted) alongside
    ``target_omitted``; pre-optional-target records stored ``"target": "default"``
    without ``target_omitted`` and still resume when ``target`` is omitted or ``"default"``.
    """
    if "target_omitted" not in state and state.get("target") == "default":
        return target in (None, "default")
    return state.get("target") == target


def target_args(target: str | None) -> list[str]:
    return ["--target", target] if target else []


def validate_timeout(value: object) -> int:
    try:
        timeout = int(value)
    except (TypeError, ValueError) as exc:
        raise DeployError("timeout_seconds must be an integer") from exc
    if not MIN_TIMEOUT_SECONDS <= timeout <= MAX_TIMEOUT_SECONDS:
        raise DeployError(
            f"timeout_seconds must be between {MIN_TIMEOUT_SECONDS} and "
            f"{MAX_TIMEOUT_SECONDS}"
        )
    return timeout


class StateStore:
    def __init__(self, project: Path, target: str | None, env: dict[str, str]):
        digest = hashlib.sha256(
            f"{project}\0{state_target_key(target)}".encode("utf-8")
        ).hexdigest()
        self.root = _state_root(env)
        self.root.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(self.root, 0o700)
        self.path = self.root / f"{digest}.json"
        self.lock_path = self.root / f"{digest}.lock"

    @contextlib.contextmanager
    def lock(
        self,
        *,
        cancel: threading.Event,
        deadline: float,
        monotonic: Callable[[], float],
    ):
        fd = os.open(self.lock_path, os.O_RDWR | os.O_CREAT, 0o600)
        acquired = False
        waited = False
        try:
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    acquired = True
                    break
                except BlockingIOError:
                    waited = True
                    if cancel.is_set():
                        raise LockWaitStopped("cancelled")
                    remaining = deadline - monotonic()
                    if remaining <= 0:
                        raise LockWaitStopped("timed_out")
                    cancel.wait(min(0.1, remaining))
            yield waited
        finally:
            if acquired:
                fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)

    def load(self) -> dict[str, Any]:
        try:
            with self.path.open(encoding="utf-8") as handle:
                value = json.load(handle)
        except (OSError, json.JSONDecodeError):
            return {}
        return value if isinstance(value, dict) else {}

    def save(self, value: dict[str, Any]) -> None:
        fd, temporary = tempfile.mkstemp(prefix=".deploy-", dir=self.root)
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                json.dump(value, handle, sort_keys=True)
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(temporary, self.path)
            os.chmod(self.path, 0o600)
        finally:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(temporary)


def _cli_env(env: dict[str, str]) -> dict[str, str]:
    clean = dict(env)
    for key in (
        "DATABRICKS_TOKEN",
        "DATABRICKS_CLIENT_ID",
        "DATABRICKS_CLIENT_SECRET",
        "DATABRICKS_HOST",
        "DATABRICKS_AUTH_TYPE",
    ):
        clean.pop(key, None)
    clean["DATABRICKS_CONFIG_FILE"] = str(
        Path(clean["HOME"]) / ".databrickscfg"
    )
    clean["DATABRICKS_CONFIG_PROFILE"] = "DEFAULT"
    return clean


def _json_from_output(output: str, *, allow_empty: bool = False) -> dict[str, Any]:
    text = output.strip()
    if allow_empty and text in ("", "null"):
        return {}
    candidates = [text]
    if "{" in text:
        candidates.append(text[text.find("{") :])
    for candidate in candidates:
        try:
            value = json.loads(candidate)
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict):
            return value
    raise CliError(f"Databricks CLI returned non-JSON output: {_safe_line(text)}")


class CliBackend:
    """Small, replaceable boundary around the Databricks CLI."""

    def __init__(self, env: dict[str, str]):
        self.env = env

    def _json(
        self,
        args: list[str],
        cwd: Path,
        timeout: int = 30,
        *,
        allow_empty: bool = False,
    ) -> dict[str, Any]:
        try:
            completed = subprocess.run(
                ["databricks", *args, "--output", "json"],
                cwd=cwd,
                env=_cli_env(self.env),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=timeout,
            )
        except FileNotFoundError as exc:
            raise CliError("The Databricks CLI is not installed") from exc
        except subprocess.TimeoutExpired as exc:
            raise CliError(f"Databricks CLI timed out while running {args[0]}") from exc
        if completed.returncode:
            detail = _safe_line(completed.stderr or completed.stdout or "CLI failed")
            raise CliError(detail, returncode=completed.returncode)
        return _json_from_output(completed.stdout, allow_empty=allow_empty)

    def bundle_summary(self, project: Path, target: str | None) -> dict[str, Any]:
        return self._json(["bundle", "summary", *target_args(target)], project, 60)

    def bundle_validate(self, project: Path, target: str | None) -> dict[str, Any]:
        return self._json(["bundle", "validate", *target_args(target)], project, 60)

    def get_app(self, project: Path, app_name: str) -> dict[str, Any]:
        return self._json(["apps", "get", app_name], project)

    def enrol_app_group(
        self, project: Path, group_id: str, member_scim_id: str
    ) -> dict[str, Any]:
        """Add one App service principal to the seat's account group.

        Uses the workspace-hosted account SCIM endpoint with the [DEFAULT]
        profile (the WT service principal, which holds Manage on the group).
        """
        group_id = str(group_id or "").strip()
        member_scim_id = str(member_scim_id or "").strip()
        body = {
            "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [
                {"op": "add", "path": "members", "value": [{"value": member_scim_id}]}
            ],
        }
        path = f"/api/2.0/account/scim/v2/Groups/{urllib.parse.quote(group_id, safe='')}"
        try:
            return self._json(
                ["api", "patch", path, "--json", json.dumps(body)],
                project,
                20,
                allow_empty=True,
            )
        except CliError as exc:
            # The member is already in the group; SCIM reports that as a conflict.
            if "409" in str(exc) or "already" in str(exc).lower():
                return {"already_member": True}
            raise

    def start_app(self, project: Path, app_name: str) -> dict[str, Any]:
        return self._json(["apps", "start", app_name, "--no-wait"], project, 60)

    def get_deployment(
        self, project: Path, app_name: str, deployment_id: str
    ) -> dict[str, Any]:
        return self._json(
            ["apps", "get-deployment", app_name, deployment_id], project
        )

    def start_submit(self, state: dict[str, Any]) -> None:
        root = Path(state["state_root"])
        log_path = root / f"{state['operation_id']}.log"
        exit_path = root / f"{state['operation_id']}.exit.json"
        for path in (log_path, exit_path):
            with contextlib.suppress(FileNotFoundError):
                path.unlink()
        token = uuid.uuid4().hex
        command = [
            sys.executable,
            os.path.abspath(__file__),
            "--submit-worker",
            "--project",
            state["project_path"],
            *target_args(state.get("target")),
            "--log-path",
            str(log_path),
            "--exit-path",
            str(exit_path),
            "--worker-token",
            token,
        ]
        process = subprocess.Popen(
            command,
            env=self.env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        state.update(
            {
                "submit_pid": process.pid,
                "submit_token": token,
                "submit_log_path": str(log_path),
                "submit_exit_path": str(exit_path),
                "log_offset": 0,
            }
        )

    def submission_status(self, state: dict[str, Any]) -> tuple[bool, int | None]:
        exit_path = Path(state.get("submit_exit_path", ""))
        try:
            with exit_path.open(encoding="utf-8") as handle:
                code = int(json.load(handle)["exit_code"])
            return True, code
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
            pass
        pid = int(state.get("submit_pid") or 0)
        return (False, None) if _pid_alive(pid) else (True, None)

    def progress_lines(self, state: dict[str, Any]) -> list[str]:
        path = Path(state.get("submit_log_path", ""))
        offset = max(0, int(state.get("log_offset") or 0))
        try:
            with path.open("rb") as handle:
                handle.seek(offset)
                chunk = handle.read(16 * 1024)
                state["log_offset"] = handle.tell()
        except OSError:
            return []
        lines = chunk.decode("utf-8", errors="replace").splitlines()
        return [_safe_line(line) for line in lines[-20:] if line.strip()]

    def cancel_submission(self, state: dict[str, Any]) -> bool:
        pid = int(state.get("submit_pid") or 0)
        if not _pid_alive(pid) or not _worker_matches(pid, state.get("submit_token", "")):
            return False
        with contextlib.suppress(ProcessLookupError, PermissionError):
            os.killpg(pid, signal.SIGTERM)
        deadline = time.monotonic() + 2.0
        while _pid_alive(pid) and time.monotonic() < deadline:
            time.sleep(0.05)
        if _pid_alive(pid):
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.killpg(pid, signal.SIGKILL)
        return True

    def cleanup_submission(self, state: dict[str, Any]) -> None:
        for key in ("submit_log_path", "submit_exit_path"):
            raw = str(state.get(key) or "")
            if not raw:
                continue
            path = Path(raw)
            # Both names were generated inside this private state directory.
            # Re-check that invariant before unlinking a value read from disk.
            try:
                path.resolve().relative_to(Path(state["state_root"]).resolve())
            except (KeyError, ValueError):
                continue
            with contextlib.suppress(FileNotFoundError, OSError):
                path.unlink()


def _pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, ValueError):
        return False
    except PermissionError:
        return True
    return True


def _worker_matches(pid: int, token: str) -> bool:
    if not token:
        return False
    proc = Path(f"/proc/{pid}/cmdline")
    if not proc.exists():
        return True
    try:
        return token.encode("utf-8") in proc.read_bytes().split(b"\0")
    except OSError:
        return False


def _app_candidates(summary: dict[str, Any]) -> list[dict[str, str]]:
    resources = summary.get("resources")
    candidates: list[dict[str, str]] = []
    if isinstance(resources, dict):
        apps = resources.get("apps")
        if isinstance(apps, dict):
            for key, value in apps.items():
                if not isinstance(value, dict):
                    continue
                name = str(value.get("name") or value.get("id") or "").strip()
                if name:
                    candidates.append(
                        {
                            "resource_key": str(key),
                            "name": name,
                            "url": str(value.get("url") or "").strip(),
                        }
                    )
        for key, value in resources.items():
            if not str(key).startswith("apps.") or not isinstance(value, dict):
                continue
            name = str(value.get("name") or value.get("id") or "").strip()
            if name:
                candidates.append(
                    {
                        "resource_key": str(key).split(".", 1)[-1],
                        "name": name,
                        "url": str(value.get("url") or "").strip(),
                    }
                )
    unique = {item["name"]: item for item in candidates}
    return sorted(unique.values(), key=lambda item: item["name"])


def _declared_scopes(bundle: dict[str, Any], resource_key: str) -> list[str]:
    """The user_api_scopes the resolved bundle gives one app resource."""
    resources = bundle.get("resources") if isinstance(bundle, dict) else None
    apps = resources.get("apps") if isinstance(resources, dict) else None
    config = apps.get(resource_key) if isinstance(apps, dict) else None
    scopes = config.get("user_api_scopes") if isinstance(config, dict) else None
    return [str(scope) for scope in scopes] if isinstance(scopes, list) else []


def _yaml_is_content(line: str) -> bool:
    stripped = line.strip()
    return bool(stripped) and not stripped.startswith("#")


def _yaml_indent(line: str) -> int:
    return len(line) - len(line.lstrip(" "))


def _yaml_unquote(value: str) -> str:
    return value.strip().strip("'\"")


def _yaml_children(lines: list[str], start: int, end: int) -> list[tuple[int, int, str, str]]:
    """Direct mapping keys in ``lines[start:end]`` as (line, indent, key, inline value)."""
    indent: int | None = None
    found: list[tuple[int, int, str, str]] = []
    for index in range(start, end):
        line = lines[index]
        if not _yaml_is_content(line):
            continue
        current = _yaml_indent(line)
        if indent is None:
            indent = current
        if current != indent:
            continue
        match = YAML_KEY_RE.match(_strip_comment(line))
        if match:
            found.append((index, current, _yaml_unquote(match.group(2)), (match.group(3) or "").strip()))
    return found


def _yaml_extent(lines: list[str], index: int, indent: int) -> int:
    """The index just past the block that the key on ``index`` opens."""
    end = index + 1
    while end < len(lines) and (not _yaml_is_content(lines[end]) or _yaml_indent(lines[end]) > indent):
        end += 1
    return end


def _yaml_child(lines: list[str], start: int, end: int, key: str) -> tuple[int, int, str, str] | None:
    for entry in _yaml_children(lines, start, end):
        if entry[2] == key:
            return entry
    return None


def _yaml_app_block(lines: list[str], resource_key: str | None) -> tuple[int, int, str, str] | None:
    """The ``resources.apps.<key>`` mapping entry, or the apps mapping when no key is given."""
    resources = _yaml_child(lines, 0, len(lines), "resources")
    if resources is None or resources[3]:
        return None
    apps = _yaml_child(lines, resources[0] + 1, _yaml_extent(lines, resources[0], resources[1]), "apps")
    if apps is None or apps[3]:
        return None
    if resource_key is None:
        return apps
    app = _yaml_child(lines, apps[0] + 1, _yaml_extent(lines, apps[0], apps[1]), resource_key)
    return app if app is not None and not app[3] else None


def _yaml_app_keys(text: str) -> list[str]:
    """The app resource keys under ``resources.apps`` in one bundle file."""
    lines = text.splitlines(keepends=True)
    apps = _yaml_app_block(lines, None)
    if apps is None:
        return []
    return [
        key
        for _, _, key, value in _yaml_children(lines, apps[0] + 1, _yaml_extent(lines, apps[0], apps[1]))
        if not value
    ]


def _yaml_is_plain_scope_item(raw: str) -> bool:
    """True when ``raw`` is a scalar scope entry, not a mapping or nested collection."""
    value = raw.strip()
    if not value or value.startswith(("{", "[")):
        return False
    if value.startswith(("'", '"')):
        return True
    return re.search(r":(?:\s|$)", value) is None


def _yaml_add_scope(text: str, resource_key: str, scope: str) -> str | None:
    """``text`` with ``scope`` added to one app's ``user_api_scopes``.

    Existing scopes are kept and nothing is removed. Returns None when the
    resource is not a plain block mapping this reader can edit without a YAML
    parser; the caller then refuses rather than guess. A result equal to
    ``text`` means the scope was already there.
    """
    newline = "\r\n" if "\r\n" in text else "\n"
    lines = text.splitlines(keepends=True)
    app = _yaml_app_block(lines, resource_key)
    if app is None:
        return None
    body_start, body_end = app[0] + 1, _yaml_extent(lines, app[0], app[1])
    body = _yaml_children(lines, body_start, body_end)
    if not body:
        return None
    child_indent = body[0][1]
    scopes = next((entry for entry in body if entry[2] == "user_api_scopes"), None)

    def insert_after(index: int, new_lines: list[str]) -> str:
        edited = list(lines)
        if not edited[index].endswith("\n"):
            edited[index] += "\n"
        edited[index + 1:index + 1] = [line + newline for line in new_lines]
        return "".join(edited)

    if scopes is None:
        last = next(
            index for index in range(body_end - 1, body_start - 1, -1) if _yaml_is_content(lines[index])
        )
        return insert_after(last, [
            " " * child_indent + "user_api_scopes:",
            " " * (child_indent + 2) + f"- {scope}",
        ])
    line_index, scope_indent, _, value = scopes
    if value.startswith("["):
        if not value.endswith("]"):
            return None
        raw_parts = [item for item in value[1:-1].split(",") if item.strip()]
        if any(not _yaml_is_plain_scope_item(item) for item in raw_parts):
            return None
        items = [_yaml_unquote(item) for item in raw_parts]
        if scope in items:
            return text
        ending = newline if lines[line_index].endswith("\n") else ""
        edited = list(lines)
        edited[line_index] = (
            " " * scope_indent + "user_api_scopes: ["
            + ", ".join([*items, scope]) + "]" + ending
        )
        return "".join(edited)
    if value:
        return None
    # Items are indented past the key, or sit at the key's own indent (YAML allows an
    # indentless sequence under a mapping key). Both belong to this list.
    items: list[int] = []
    for index in range(line_index + 1, len(lines)):
        if not _yaml_is_content(lines[index]):
            continue
        indent = _yaml_indent(lines[index])
        if indent > scope_indent or (indent == scope_indent and lines[index].lstrip().startswith("-")):
            items.append(index)
        else:
            break
    if any(
        not _strip_comment(lines[index]).lstrip().startswith("-")
        or not _yaml_is_plain_scope_item(_strip_comment(lines[index]).lstrip()[1:])
        for index in items
    ):
        return None  # an object-valued item: not a plain scope list this reader edits
    if any(
        _yaml_unquote(_strip_comment(lines[index]).lstrip()[1:]) == scope
        for index in items
    ):
        return text
    if items:
        item_indent, last = _yaml_indent(lines[items[0]]), items[-1]
    else:
        item_indent, last = scope_indent + 2, line_index
    return insert_after(last, [" " * item_indent + f"- {scope}"])


def _yaml_add_scopes(text: str, resource_key: str, scopes: tuple[str, ...] = REQUIRED_USER_SCOPES) -> str | None:
    """``text`` with every scope in ``scopes`` present on one app, or None if any edit is refused."""
    edited = text
    for scope in scopes:
        step = _yaml_add_scope(edited, resource_key, scope)
        if step is None:
            return None
        edited = step
    return edited


def _bundle_files(project: Path) -> list[Path]:
    """Bundle files that can hold an app resource: databricks.yml and resources/*.yml."""
    files: list[Path] = []
    root = project / "databricks.yml"
    if root.is_file() and not root.is_symlink():
        files.append(root)
    directory = project / "resources"
    if directory.is_dir() and not directory.is_symlink():
        for path in sorted(directory.iterdir()):
            if path.suffix in (".yml", ".yaml") and path.is_file() and not path.is_symlink():
                files.append(path)
    return files


def _read_text(path: Path) -> str:
    with path.open(encoding="utf-8", newline="") as handle:
        return handle.read()


def _write_text(path: Path, text: str) -> None:
    with path.open("w", encoding="utf-8", newline="") as handle:
        handle.write(text)


def _scope_refusal(resource_key: str) -> str:
    names = " and ".join(f"`- {scope}`" for scope in REQUIRED_USER_SCOPES)
    return (
        f"The bundle's app resource {resource_key} is not a form this deploy tool can edit. "
        f"Add {names} under its user_api_scopes in databricks.yml, then deploy again."
    )


def declare_ai_gateway_in_project(project: Path) -> list[str]:
    """Add ``ai-gateway`` to every app resource in a project's bundle files, text only.

    ``workshop-init-project`` calls this right after a scaffold, before the first
    commit, so the App is created with the scope. Returns the files it changed.
    """
    pending: list[tuple[Path, str]] = []
    for path in _bundle_files(project):
        try:
            original = _read_text(path)
        except UnicodeDecodeError as exc:
            raise DeployError(f"{path.name} is not UTF-8 text ({_safe_line(exc)}); nothing was changed") from exc
        text = original
        for key in _yaml_app_keys(original):
            edited = _yaml_add_scopes(text, key)
            if edited is None:
                raise DeployError(_scope_refusal(key) + " Nothing was changed.")
            text = edited
        if text != original:
            pending.append((path, text))
    # Every file is checked before the first write, so a refusal leaves the project as it was.
    for path, text in pending:
        _write_text(path, text)
    return [path.name for path, _ in pending]


def _lakebase_resource_names(app_config: dict[str, Any]) -> tuple[bool, list[str]]:
    """Whether the app binds a Lakebase resource, and the names given to those bindings."""
    bound = False
    names: list[str] = []
    for item in app_config.get("resources") or []:
        if isinstance(item, dict) and any(key in item for key in LAKEBASE_RESOURCE_KEYS):
            bound = True
            name = str(item.get("name") or "").strip()
            if name:
                names.append(name)
    return bound, names


def _strip_comment(line: str) -> str:
    """A YAML line without its trailing comment (`key: value  # note`)."""
    return re.sub(r"\s+#.*$", "", line).rstrip()


def _flow_fields(text: str) -> dict[str, str]:
    """The keys of a flow mapping such as ``{name: X, valueFrom: Y}``."""
    fields: dict[str, str] = {}
    for part in text.strip().strip("{}").split(","):
        key, sep, value = part.partition(":")
        if sep and key.strip() in ("name", "value", "valueFrom"):
            fields[key.strip()] = value.strip().strip("'\"")
    return fields


def _env_items(lines: list[str]) -> list[dict[str, str]]:
    """Each env list item as its fields, whatever order its keys come in and in either YAML style."""
    items: list[dict[str, str]] = []
    index = 0
    while index < len(lines):
        item = ENV_ITEM_RE.match(lines[index])
        if not item:
            index += 1
            continue
        indent = len(item.group(1))
        rest = (item.group(2) or "").strip()
        fields: dict[str, str] = {}
        if rest.startswith("{"):
            fields.update(_flow_fields(rest))
        else:
            first = ENV_KEY_RE.match(rest) if rest else None
            if first:
                fields[first.group(1)] = first.group(2).strip("'\"")
        last_key = next(iter(fields), "")
        follower = index + 1
        while follower < len(lines):
            line = lines[follower]
            if not line.strip():
                follower += 1
                continue
            if len(line) - len(line.lstrip()) <= indent:
                break
            key = ENV_KEY_RE.match(line)
            if key:
                name_, value = key.group(1), key.group(2).strip("'\"")
                if name_ == "resource" and last_key == "valueFrom" and not fields.get("valueFrom"):
                    fields["valueFrom"] = value
                elif name_ != "resource":
                    fields[name_] = value
                    last_key = name_
            follower += 1
        items.append(fields)
        index = follower
    return items


def _env_entry(text: str, name: str) -> dict[str, str] | None:
    """The ``value`` and ``valueFrom`` fields of the env item named ``name`` in an app.yml.

    app.yml is read without a YAML parser: items may list their keys in any
    order, may be written as flow mappings, and may use the nested
    ``valueFrom:`` / ``resource:`` form. None when the entry is absent.
    """
    for fields in _env_items([_strip_comment(line) for line in text.splitlines()]):
        if fields.get("name") == name:
            return {key: value for key, value in fields.items() if key in ("value", "valueFrom")}
    return None


def _code_reads_env(source_dir: Path, name: str) -> bool:
    """True when app code in ``source_dir`` mentions ``name``; True too when the scan is too large to be sure."""
    scanned = 0
    needles = (name, *LAKEBASE_ENDPOINT_USES)
    for root, dirs, files in os.walk(source_dir):
        dirs[:] = [d for d in dirs if d not in SCAN_SKIP_DIRS and (d in SCAN_KEPT_DOTDIRS or not d.startswith("."))]
        for file in files:
            if not file.endswith(CODE_SUFFIXES):
                continue
            scanned += 1
            if scanned > SCAN_MAX_FILES:
                return True
            path = Path(root) / file
            try:
                if path.stat().st_size > SCAN_MAX_BYTES:
                    continue
                text = path.read_text(encoding="utf-8", errors="ignore")
                if any(needle in text for needle in needles):
                    return True
            except OSError:
                continue
    return False


def lakebase_problems(bundle: dict[str, Any], project: Path, apps: list[dict[str, str]]) -> list[str]:
    """What would leave a Lakebase-backed app unable to connect, named before the deploy.

    databricks.yml binds the Lakebase resource to the app. The platform injects
    PGHOST, PGDATABASE, PGUSER and PGPORT for it, but not LAKEBASE_ENDPOINT. Code
    that reads LAKEBASE_ENDPOINT needs app.yml to set it from the resource with
    ``valueFrom`` (31 Oct, F-017: the crew app's Due tab failed on the live app
    until the agent set the variable by hand).
    """
    resources = bundle.get("resources") if isinstance(bundle, dict) else None
    app_configs = resources.get("apps") if isinstance(resources, dict) else None
    problems: list[str] = []
    for app in apps:
        config = app_configs.get(app["resource_key"]) if isinstance(app_configs, dict) else None
        bound, names = _lakebase_resource_names(config) if isinstance(config, dict) else (False, [])
        if not bound:
            continue
        source_dir = Path(str(config.get("source_code_path") or ".").strip()).expanduser()
        if not source_dir.is_absolute():
            source_dir = project / source_dir
        if not _code_reads_env(source_dir, LAKEBASE_ENDPOINT_ENV):
            continue  # this app reaches Lakebase another way; nothing to bind
        if not names:
            problems.append(
                f"databricks.yml gives the Lakebase resource of {app['name']} no name. "
                "Add `name: postgres` to it, so app.yml can read it."
            )
            continue
        resource = names[0]
        # The file the deploy ships: the app's source directory, not a fallback.
        config_file = next(
            (path for path in (source_dir / name for name in APP_CONFIG_FILES) if path.is_file()), None
        )
        if config_file is None:
            problems.append(
                f"The app code reads {LAKEBASE_ENDPOINT_ENV}, but there is no app.yml or app.yaml in "
                f"{source_dir.name or '.'}. Create one with env entry {LAKEBASE_ENDPOINT_ENV}."
            )
            continue
        entry = _env_entry(config_file.read_text(encoding="utf-8", errors="replace"), LAKEBASE_ENDPOINT_ENV)
        if entry is None:
            problems.append(
                f"The app code reads {LAKEBASE_ENDPOINT_ENV}, and {config_file.name} has no entry for it. "
                f"Add under env: `- name: {LAKEBASE_ENDPOINT_ENV}` then `  valueFrom: {resource}`."
            )
        elif "value" not in entry and entry.get("valueFrom") not in names:
            problems.append(
                f"{config_file.name} reads {LAKEBASE_ENDPOINT_ENV} with valueFrom "
                f"'{entry.get('valueFrom', '')}', which is not a Lakebase resource in databricks.yml "
                f"(declared: {', '.join(names)}). Set valueFrom to one of those names."
            )
    return problems


def _scopes_missing_before(snapshot: object, live_scopes: list[str] | None) -> list[str] | str | None:
    """Required scopes the live App lacked: None when no App existed, "unknown" when the payload did not say."""
    if snapshot is None:
        return None
    if live_scopes is None:
        return "unknown"
    return [scope for scope in REQUIRED_USER_SCOPES if scope not in live_scopes]


def _live_scopes(app: dict[str, Any]) -> list[str] | None:
    """The user authorization scopes the live App has, or None when the payload has none.

    The Go CLI omits an empty ``user_api_scopes`` (``omitempty``), while the platform
    still populates ``effective_user_api_scopes`` with the default identity scopes.
    """
    if not isinstance(app, dict):
        return None
    for key in ("user_api_scopes", "effective_user_api_scopes"):
        scopes = app.get(key)
        if isinstance(scopes, list):
            return [str(scope) for scope in scopes]
    return None


def _deployment_id(value: object) -> str:
    return str(value or "").strip()


def _snapshot(app: dict[str, Any]) -> dict[str, str]:
    active = app.get("active_deployment") or {}
    pending = app.get("pending_deployment") or {}
    app_status = app.get("app_status") or {}
    compute_status = app.get("compute_status") or {}
    return {
        "active_deployment_id": _deployment_id(active.get("deployment_id")),
        "active_deployment_state": str((active.get("status") or {}).get("state") or ""),
        "pending_deployment_id": _deployment_id(pending.get("deployment_id")),
        "pending_deployment_state": str((pending.get("status") or {}).get("state") or ""),
        "app_state": str(app_status.get("state") or ""),
        "compute_state": str(compute_status.get("state") or ""),
        "url": str(app.get("url") or "").strip(),
    }


def _new_deployment_id(snapshot: dict[str, str], baseline: set[str]) -> str:
    pending = snapshot["pending_deployment_id"]
    active = snapshot["active_deployment_id"]
    if pending and pending not in baseline:
        return pending
    if active and active not in baseline:
        return active
    return ""


def _healthy(snapshot: dict[str, str]) -> bool:
    return snapshot["app_state"] == "RUNNING" and snapshot["compute_state"] == "ACTIVE"


def _control_tower_managed(app: dict[str, Any], env: dict[str, str]) -> bool:
    """WT itself and Omnigent are CT-managed; they never join an attendee group.

    Mirrors server/attendee_app_group.is_control_tower_managed.
    """
    from urllib.parse import urlsplit

    own_client_id = str(env.get("DATABRICKS_CLIENT_ID") or "").strip()
    client_id = str(app.get("service_principal_client_id") or "").strip()
    if own_client_id and client_id == own_client_id:
        return True
    own_name = str(env.get("DATABRICKS_APP_NAME") or "").strip()
    if own_name and str(app.get("name") or app.get("app_name") or "").strip() == own_name:
        return True
    omnigent = str(env.get("OMNIGENT_APP_URL") or "").strip()
    url = str(app.get("url") or "").strip()
    omni_host = urlsplit(omnigent).netloc.lower() if omnigent else ""
    url_host = urlsplit(url).netloc.lower() if url else ""
    return bool(omni_host and url_host == omni_host)


@dataclass
class LocalReporter:
    env: dict[str, str]

    def _post(self, path: str, payload: dict[str, Any]) -> dict[str, Any] | None:
        app = self.env.get("WORKSHOP_APP_URL", "").strip()
        email = self.env.get("WORKSHOP_USER_EMAIL", "").strip()
        capability_path = Path(self.env["HOME"]) / ".config" / "workshop" / "callback-capability"
        if not app or not email:
            return None
        try:
            capability = capability_path.read_text(encoding="utf-8").strip()
        except OSError:
            return None
        body = json.dumps({"email": email, **payload}).encode("utf-8")
        request = urllib.request.Request(
            f"{app.rstrip('/')}{path}",
            data=body,
            headers={
                "Content-Type": "application/json",
                "X-Workshop-Capability": capability,
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(request, timeout=5) as response:
                value = json.loads(response.read().decode("utf-8"))
            return value if isinstance(value, dict) else {}
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            return None

    def __call__(self, result: dict[str, Any], source: str) -> None:
        if result["status"] == "succeeded":
            handoff = self._post(
                "/api/entitlements/reconcile", {"resource_type": "apps"}
            )
            result["entitlement_handoff"] = (
                "requested" if handoff is not None else "unavailable"
            )
        self._post(
            "/api/tools/app-deploy/event",
            {
                "outcome": result["status"],
                "reason": result["reason"],
                "duration_ms": min(
                    MAX_TIMEOUT_SECONDS * 1000,
                    max(0, float(result["duration_ms"])),
                ),
                "attempts": min(10_000, max(0, int(result["attempts"]))),
                "resumed": result["resumed"],
                "source": source,
            },
        )


class DeployController:
    def __init__(
        self,
        env: dict[str, str] | None = None,
        *,
        backend: Any | None = None,
        reporter: Callable[[dict[str, Any], str], None] | None = None,
        monotonic: Callable[[], float] = time.monotonic,
        wall_time: Callable[[], float] = time.time,
        poll_seconds: float | None = None,
    ):
        self.env = dict(os.environ if env is None else env)
        if not self.env.get("HOME"):
            raise DeployError("HOME is required")
        self.backend = backend or CliBackend(self.env)
        self.reporter = reporter or LocalReporter(self.env)
        self.monotonic = monotonic
        self.wall_time = wall_time
        configured_poll = self.env.get("WORKSHOP_APP_DEPLOY_POLL_SECONDS", "")
        self.poll_seconds = (
            float(configured_poll)
            if poll_seconds is None and configured_poll
            else (DEFAULT_POLL_SECONDS if poll_seconds is None else poll_seconds)
        )

    def deploy(
        self,
        *,
        project_path: str = ".",
        target: str | None = None,
        timeout_seconds: int = DEFAULT_TIMEOUT_SECONDS,
        cancel: threading.Event | None = None,
        progress: Callable[[str], None] | None = None,
        source: str = "cli",
        cwd: Path | None = None,
    ) -> dict[str, Any]:
        project = resolve_project_path(project_path, self.env, cwd)
        target = normalize_target(target)
        timeout = validate_timeout(timeout_seconds)
        cancel = cancel or threading.Event()
        progress = progress or (lambda _message: None)
        store = StateStore(project, target, self.env)
        call_started = self.monotonic()
        deadline = call_started + timeout

        try:
            with store.lock(
                cancel=cancel,
                deadline=deadline,
                monotonic=self.monotonic,
            ) as waited_for_lock:
                if waited_for_lock and (
                    stopped := self._stop_reason(cancel, deadline)
                ):
                    raise LockWaitStopped(stopped)
                state = store.load()
                same_operation = bool(
                    state
                    and state.get("project_path") == str(project)
                    and _same_target(state, target)
                )
                if (
                    waited_for_lock
                    and same_operation
                    and state.get("phase") in TERMINAL_PHASES
                ):
                    # A concurrent duplicate call waited behind the owner of
                    # this operation. Return that operation's terminal result;
                    # do not interpret lock release as a request to deploy again.
                    result = self._result(
                        state,
                        state["phase"],
                        str(state.get("reason") or state["phase"]),
                        True,
                        call_started,
                    )
                else:
                    resumed = bool(
                        same_operation
                        and state.get("phase") not in TERMINAL_PHASES
                    )
                    if resumed:
                        progress(
                            f"Resuming deployment for {state.get('app_name', 'the app')}"
                        )
                        # A process can disappear after the durable intent is written
                        # but before the detached submit worker's pid is committed.
                        # Recreate the worker only in that pre-submit state; once a pid
                        # or deployment id exists, polling is the duplicate-safe path.
                        if (
                            state.get("phase") == "submitting"
                            and not state.get("submit_pid")
                            and not state.get("deployment_id")
                        ):
                            self.backend.start_submit(state)
                            store.save(state)
                    else:
                        previous_state = state
                        state = self._start(
                            project, target, store, progress, cancel=cancel, deadline=deadline
                        )
                        if previous_state:
                            cleanup = getattr(self.backend, "cleanup_submission", None)
                            if cleanup is not None:
                                cleanup(previous_state)
                    result = self._wait(
                        state,
                        store,
                        deadline=deadline,
                        cancel=cancel,
                        progress=progress,
                        resumed=resumed,
                        call_started=call_started,
                    )
        except LockWaitStopped as exc:
            state = store.load()
            result = self._result(
                state,
                exc.reason,
                f"lock_{exc.reason}",
                bool(state),
                call_started,
                remote_may_continue=True,
            )
        except ComputeWaitStopped as exc:
            # Stopped before anything was submitted, so no deployment can be running.
            result = self._result(
                {"app_name": exc.app_name},
                exc.reason,
                f"compute_{exc.reason}",
                False,
                call_started,
                remote_may_continue=False,
            )
        try:
            self.reporter(result, source)
        except Exception:
            pass
        return result

    def _ensure_compute_active(
        self,
        project: Path,
        app_name: str,
        snapshot: dict[str, str],
        progress: Callable[[str], None],
        *,
        cancel: threading.Event,
        deadline: float | None,
    ) -> None:
        """Start the app's compute and wait for ACTIVE before submitting (F-024).

        Nothing is submitted until compute reports ACTIVE. CLI errors inside the
        window are transient: a failed start may already be in progress, so
        polling continues, a failed read is retried on the next poll, and the
        start is retried at most once more while compute is still STOPPED or
        ERROR. If the window (``COMPUTE_READY_TIMEOUT_SECONDS``, capped by the
        deploy deadline) ends without ACTIVE, the deploy is refused with a
        ``DeployError``. A cancel stops the wait without starting or submitting.
        """
        compute = snapshot["compute_state"]
        if not compute or compute == "ACTIVE":
            return
        started_at = self.monotonic()
        limit = started_at + COMPUTE_READY_TIMEOUT_SECONDS
        if deadline is not None:
            limit = min(limit, deadline)
        start = getattr(self.backend, "start_app", None)
        starts = 0
        last_error = ""

        def stop_if_cancelled() -> None:
            if self._stop_reason(cancel, limit) == "cancelled":
                raise ComputeWaitStopped("cancelled", app_name)

        def try_start() -> None:
            nonlocal starts, last_error
            stop_if_cancelled()
            starts += 1
            try:
                start(project, app_name)
            except CliError as exc:
                last_error = str(exc)  # transient: the start may already be under way

        stop_if_cancelled()
        if compute in {"STOPPED", "STOPPING", "ERROR"} and start is not None:
            progress(f"Starting {app_name}'s compute before deploying")
            try_start()
        else:
            progress(f"Waiting for {app_name}'s compute ({compute}) before deploying")
        while True:
            stop_if_cancelled()
            if self._stop_reason(cancel, limit) == "timed_out":
                break
            self._pause(cancel, limit)
            stop_if_cancelled()
            try:
                current = _snapshot(self.backend.get_app(project, app_name))
            except CliError as exc:
                last_error = str(exc)  # transient: read again on the next poll
                continue
            compute = current["compute_state"] or compute
            if compute == "ACTIVE":
                return
            if compute in {"STOPPED", "ERROR"} and start is not None and starts < 2:
                try_start()
        minutes = max(1, round((self.monotonic() - started_at) / 60))
        detail = f" (last error: {_safe_line(last_error)})" if last_error else ""
        raise DeployError(
            f"App compute is still {compute} after {minutes} min{detail}; "
            "try the deploy again, or ask a facilitator"
        )

    def _config_problems(
        self,
        project: Path,
        target: str | None,
        apps: list[dict[str, str]],
        bundle: dict[str, Any] | None = None,
    ) -> list[str]:
        # Only an app whose code reads the endpoint can be broken by a missing entry, so
        # the cheap scan decides first. A plain app never pays for validate, and a validate
        # error can't block it.
        if bundle is None and not _code_reads_env(project, LAKEBASE_ENDPOINT_ENV):
            return []
        # The resolved local bundle, not the deployed one: a first deploy has
        # no deployed state, and a new Lakebase binding is not deployed yet.
        if bundle is None:
            validate = getattr(self.backend, "bundle_validate", None)
            if validate is None:
                return []
            try:
                bundle = validate(project, target)
            except CliError as exc:
                # Fail closed: an unchecked Lakebase binding must not ship without its endpoint.
                raise DeployError(
                    f"The Lakebase settings could not be checked ({exc}). Retry the deploy; "
                    "nothing was deployed."
                ) from exc
        return lakebase_problems(bundle, project, apps)

    def _declare_ai_gateway(self, project: Path, target: str | None, app: dict[str, str]) -> str:
        """Make the bundle's app declare the ``ai-gateway`` scope, and say what was done.

        The scope lets the attendee's token call models on ``/ai-gateway``.
        Returns ``declared`` (already in place, no edit), ``added`` (the bundle was
        edited and checked) or ``unchecked`` (the App is not in a bundle file this
        tool can edit, and the resolved bundle could not be read). An edit that
        cannot be checked is undone, and nothing is deployed.
        """
        key = app["resource_key"]
        located = None
        for path in _bundle_files(project):
            try:
                original = _read_text(path)
            except UnicodeDecodeError as exc:
                raise DeployError(
                    f"{path.name} is not UTF-8 text ({_safe_line(exc)}); nothing was deployed."
                ) from exc
            if key in _yaml_app_keys(original):
                located = (path, original, _yaml_add_scopes(original, key))
                break
        if located is not None and located[2] == located[1]:
            return "declared"  # the bundle file already says so; no CLI call needed
        if located is not None and located[2] is not None:
            return self._edit_scopes(project, target, key, *located)
        try:
            declared = _declared_scopes(self.backend.bundle_validate(project, target), key)
        except CliError as exc:
            if located is not None:
                raise DeployError(_scope_refusal(key)) from exc
            return "unchecked"
        if all(scope in declared for scope in REQUIRED_USER_SCOPES):
            return "declared"
        raise DeployError(_scope_refusal(key))

    def _edit_scopes(
        self, project: Path, target: str | None, key: str, path: Path, original: str, edited: str
    ) -> str:
        try:
            before = _declared_scopes(self.backend.bundle_validate(project, target), key)
        except CliError as exc:
            raise DeployError(
                f"The app's user authorization scopes could not be checked ({_safe_line(exc)}). "
                "Retry the deploy; nothing was deployed."
            ) from exc
        if all(scope in before for scope in REQUIRED_USER_SCOPES):
            return "declared"  # declared through a target or include the text check did not see
        _write_text(path, edited)
        try:
            now = _declared_scopes(self.backend.bundle_validate(project, target), key)
        except CliError as exc:
            _write_text(path, original)
            raise DeployError(
                f"The edited bundle could not be checked ({_safe_line(exc)}). "
                "The file was restored; nothing was deployed."
            ) from exc
        if any(scope not in now for scope in REQUIRED_USER_SCOPES) or not set(before) <= set(now):
            _write_text(path, original)
            raise DeployError(
                "The edited bundle did not keep the app's scopes as expected. "
                f"The file was restored. {_scope_refusal(key)}"
            )
        return "added"

    def _scope_message(self, state: dict[str, Any], app: dict[str, Any]) -> str:
        """What the agent must tell the attendee about the required user scopes after a success."""
        names = ", ".join(f"`{scope}`" for scope in REQUIRED_USER_SCOPES)
        if state.get("ai_gateway_edit") == "unchecked":
            return (
                f"The {names} scopes could not be checked, because the App is not in a bundle "
                "file this tool edits. If model or Genie calls as the attendee fail, add them "
                "under user_api_scopes in databricks.yml and deploy again."
            )
        before = state.get("scopes_missing_before")
        live = _live_scopes(app)
        if live is None:
            return (
                f"The App's user authorization scopes were not returned, so {names} could not be "
                "confirmed. If model or Genie calls as the attendee fail, ask a facilitator."
            )
        missing_now = [scope for scope in REQUIRED_USER_SCOPES if scope not in live]
        if missing_now:
            return (
                f"The live App does not show the scope(s) {', '.join(f'`{s}`' for s in missing_now)} "
                "after this deploy, so model or Genie calls as the attendee will fail. Ask a "
                "facilitator to add them to the App."
            )
        if before is None:
            return (
                f"The App asks for the {names} scopes. The attendee clicks Allow once, on the "
                "first open of the App."
            )
        if before == "unknown" or before:
            return (
                "The App has just gained scopes. Tell the attendee: reopen the App and click "
                "Allow. Model and Genie calls fail until they do."
            )
        return ""

    def _start(
        self,
        project: Path,
        target: str | None,
        store: StateStore,
        progress: Callable[[str], None],
        *,
        cancel: threading.Event | None = None,
        deadline: float | None = None,
    ) -> dict[str, Any]:
        summary_error: CliError | None = None
        validated: dict[str, Any] | None = None
        try:
            bundle = self.backend.bundle_summary(project, target)
            apps = _app_candidates(bundle)
        except CliError as exc:
            # ``bundle summary`` reads deployed bundle state, which may not
            # exist on an attendee's first deployment. Validation resolves the
            # local bundle configuration and is therefore the correct fallback.
            summary_error = exc
            apps = []
        if not apps:
            validate = getattr(self.backend, "bundle_validate", None)
            if validate is None:
                if summary_error is not None:
                    raise summary_error
            else:
                bundle = validate(project, target)
                validated = bundle
                apps = _app_candidates(bundle)
        if len(apps) != 1:
            names = ", ".join(item["name"] for item in apps) or "none"
            raise DeployError(
                "The deploy tool requires exactly one Databricks App resource; "
                f"bundle summary reported {names}"
            )
        app = apps[0]
        problems = self._config_problems(project, target, apps, validated)
        if problems:
            # Refused before anything is written or submitted, so the next call starts clean.
            raise DeployError(" ".join(problems) + " Nothing was deployed.")
        baseline: set[str] = set()
        snapshot: dict[str, str] | None = None
        live_scopes: list[str] | None = None
        try:
            app_payload = self.backend.get_app(project, app["name"])
            snapshot = _snapshot(app_payload)
            live_scopes = _live_scopes(app_payload)
            baseline.update(
                value
                for value in (
                    snapshot["active_deployment_id"],
                    snapshot["pending_deployment_id"],
                )
                if value
            )
            if snapshot["url"]:
                app["url"] = snapshot["url"]
        except CliError:
            pass  # first deployment: the app may not exist yet
        # Before anything is submitted: the scope is set at create, so the
        # attendee's one Allow click covers the App from its first open.
        edit = self._declare_ai_gateway(project, target, app)
        if snapshot is not None:
            # Outside the try: the wait's DeployError must reach the caller,
            # and its own CLI errors are handled inside it.
            self._ensure_compute_active(
                project, app["name"], snapshot, progress,
                cancel=cancel or threading.Event(), deadline=deadline,
            )
        state: dict[str, Any] = {
            "schema_version": 1,
            "operation_id": uuid.uuid4().hex,
            "phase": "submitting",
            "project_path": str(project),
            "target": target,
            "target_omitted": target is None,
            "app_name": app["name"],
            "app_url": app["url"],
            "baseline_deployment_ids": sorted(baseline),
            "deployment_id": "",
            "created_at": self.wall_time(),
            "attempts": 0,
            "state_root": str(store.root),
            # None: no App existed before this deploy. Otherwise whether the live App had ai-gateway.
            "scopes_missing_before": _scopes_missing_before(snapshot, live_scopes),
            "ai_gateway_edit": edit,
        }
        store.save(state)
        self.backend.start_submit(state)
        store.save(state)
        progress(f"Submitting {app['name']} with databricks apps deploy")
        return state

    def _wait(
        self,
        state: dict[str, Any],
        store: StateStore,
        *,
        deadline: float,
        cancel: threading.Event,
        progress: Callable[[str], None],
        resumed: bool,
        call_started: float,
    ) -> dict[str, Any]:
        project = Path(state["project_path"])
        submit_code: int | None = state.get("submit_exit_code")
        while state.get("phase") == "submitting":
            for line in self.backend.progress_lines(state):
                state["last_submit_message"] = line
                progress(line)
            done, code = self.backend.submission_status(state)
            self._observe_app(state, project)
            store.save(state)
            if done:
                if code is None:
                    code = 1
                    state["last_submit_message"] = MISSING_SUBMIT_STATUS_MESSAGE
                    progress(MISSING_SUBMIT_STATUS_MESSAGE)
                submit_code = code
                state["submit_exit_code"] = code
                state["submission_finished_at"] = self.wall_time()
                state["phase"] = "polling"
                store.save(state)
                break
            stopped = self._stop_reason(cancel, deadline)
            if stopped:
                killed = self.backend.cancel_submission(state)
                self._observe_app(state, project)
                if state.get("deployment_id"):
                    state["phase"] = "polling"
                    store.save(state)
                else:
                    state["phase"] = "failed"
                    state["reason"] = f"submit_{stopped}"
                    store.save(state)
                return self._result(
                    state,
                    stopped,
                    f"submit_{stopped}",
                    resumed,
                    call_started,
                    remote_may_continue=bool(state.get("deployment_id") or not killed),
                )
            self._pause(cancel, deadline)

        last_progress = ""
        while True:
            stopped = self._stop_reason(cancel, deadline)
            if stopped:
                state["phase"] = "polling"
                state["last_outcome"] = stopped
                store.save(state)
                return self._result(
                    state,
                    stopped,
                    stopped,
                    resumed,
                    call_started,
                    remote_may_continue=True,
                )
            state["attempts"] = int(state.get("attempts") or 0) + 1
            try:
                app = self.backend.get_app(project, state["app_name"])
                snapshot = _snapshot(app)
                # The App's service principal can appear only after submission
                # ends, or enrolment can fail transiently: keep retrying here.
                self._observe_app_sp(state, project, app)
                if snapshot["url"]:
                    state["app_url"] = snapshot["url"]
                if not state.get("deployment_id"):
                    state["deployment_id"] = _new_deployment_id(
                        snapshot, set(state.get("baseline_deployment_ids") or [])
                    )
                deployment_state = ""
                deployment_message = ""
                if state.get("deployment_id"):
                    deployment = self.backend.get_deployment(
                        project, state["app_name"], state["deployment_id"]
                    )
                    status = deployment.get("status") or {}
                    deployment_state = str(status.get("state") or "")
                    deployment_message = _safe_line(status.get("message") or "")
                state.update(
                    {
                        "deployment_state": deployment_state,
                        "app_state": snapshot["app_state"],
                        "compute_state": snapshot["compute_state"],
                    }
                )
                status_line = (
                    f"deployment={deployment_state or 'discovering'} "
                    f"app={snapshot['app_state'] or 'unknown'} "
                    f"compute={snapshot['compute_state'] or 'unknown'}"
                )
                if status_line != last_progress:
                    progress(status_line)
                    last_progress = status_line
                if deployment_state in {"FAILED", "CANCELLED"}:
                    return self._finish(
                        state,
                        store,
                        "failed",
                        deployment_state.lower(),
                        resumed,
                        call_started,
                        message=deployment_message,
                    )
                if deployment_state == "SUCCEEDED" and _healthy(snapshot):
                    return self._finish(
                        state,
                        store,
                        "succeeded",
                        "deployment_succeeded",
                        resumed,
                        call_started,
                        message=self._scope_message(state, app),
                    )
                if deployment_state == "SUCCEEDED" and (
                    snapshot["app_state"] == "CRASHED"
                    or snapshot["compute_state"] == "ERROR"
                ):
                    # App-level state can describe the previous deployment
                    # while the exact new deployment is still IN_PROGRESS.
                    # Treat it as terminal only after the target deployment
                    # itself has completed.
                    return self._finish(
                        state,
                        store,
                        "failed",
                        "app_unhealthy",
                        resumed,
                        call_started,
                    )
                if submit_code not in (None, 0) and not state.get("deployment_id"):
                    return self._finish(
                        state,
                        store,
                        "failed",
                        "cli_failed",
                        resumed,
                        call_started,
                        message=state.get("last_submit_message", ""),
                    )
            except CliError as exc:
                state["last_poll_error"] = _safe_line(exc)
                progress(f"Transient status check failed: {_safe_line(exc)}")
                if submit_code not in (None, 0) and not state.get("deployment_id"):
                    return self._finish(
                        state,
                        store,
                        "failed",
                        "cli_failed",
                        resumed,
                        call_started,
                        message=state.get("last_submit_message") or _safe_line(exc),
                    )
            store.save(state)
            self._pause(cancel, deadline)

    def _observe_app(self, state: dict[str, Any], project: Path) -> None:
        try:
            app_payload = self.backend.get_app(project, state["app_name"])
            snapshot = _snapshot(app_payload)
        except CliError:
            return
        if snapshot["url"]:
            state["app_url"] = snapshot["url"]
        if not state.get("deployment_id"):
            state["deployment_id"] = _new_deployment_id(
                snapshot, set(state.get("baseline_deployment_ids") or [])
            )
        self._observe_app_sp(state, project, app_payload)

    def _observe_app_sp(
        self, state: dict[str, Any], project: Path, app_payload: dict[str, Any]
    ) -> None:
        sp_id = (
            app_payload.get("service_principal_client_id")
            or app_payload.get("service_principal_id")
        )
        if not sp_id:
            return
        self._enrol_attendee_group(state, project, app_payload)
        if not state.get("early_entitlement_reconciled"):
            post = getattr(self.reporter, "_post", None)
            if callable(post):
                try:
                    if post("/api/entitlements/reconcile", {"resource_type": "apps"}) is not None:
                        state["early_entitlement_reconciled"] = True
                except Exception:
                    pass

    def _enrol_attendee_group(
        self, state: dict[str, Any], project: Path, app_payload: dict[str, Any]
    ) -> None:
        """Put the new App's service principal in the seat group (Control Tower option 2).

        One attempt per poll, so the deploy loop never waits on enrolment. The
        record in the operation state counts attempts across polls and stops at
        twelve; the entitlement reconciler keeps retrying after that. Never raised.
        """
        group_id = str(self.env.get("WORKSHOP_ATTENDEE_APP_GROUP_ID") or "").strip()
        enrol = getattr(self.backend, "enrol_app_group", None)
        if not group_id or not callable(enrol):
            return
        record = state.get("attendee_app_group") or {}
        if record.get("ok") or int(record.get("attempts") or 0) >= 12:
            return
        member = str(app_payload.get("service_principal_id") or "").strip()
        if not member or _control_tower_managed(app_payload, self.env):
            return
        attempts = int(record.get("attempts") or 0) + 1
        try:
            enrol(project, group_id, member)
            record = {"ok": True, "attempts": attempts, "error": ""}
        except Exception as exc:  # noqa: BLE001 — enrolment never fails the deploy
            record = {"ok": False, "attempts": attempts, "error": _safe_line(exc)[:200]}
        state["attendee_app_group"] = record

    def _pause(self, cancel: threading.Event, deadline: float) -> None:
        remaining = max(0.0, deadline - self.monotonic())
        cancel.wait(min(max(0.01, self.poll_seconds), remaining))

    def _stop_reason(self, cancel: threading.Event, deadline: float) -> str:
        if cancel.is_set():
            return "cancelled"
        if self.monotonic() >= deadline:
            return "timed_out"
        return ""

    def _finish(
        self,
        state: dict[str, Any],
        store: StateStore,
        status: str,
        reason: str,
        resumed: bool,
        call_started: float,
        *,
        message: str = "",
    ) -> dict[str, Any]:
        state["phase"] = status
        state["reason"] = reason
        state["finished_at"] = self.wall_time()
        store.save(state)
        if status == "succeeded" and state.get("app_url") and state.get("project_path"):
            self._record_workflow_preview(Path(state["project_path"]), str(state["app_url"]))
        result = self._result(
            state, status, reason, resumed, call_started, message=message
        )
        cleanup = getattr(self.backend, "cleanup_submission", None)
        if cleanup is not None:
            cleanup(state)
        return result

    def _record_workflow_preview(self, project: Path, app_url: str) -> None:
        readme_path = project / "README.md"
        if readme_path.is_file() and not readme_path.is_symlink():
            try:
                readme_text = readme_path.read_text(encoding="utf-8", errors="replace")
                updated_readme = readme_text.replace(
                    "Live URL: (added once the app is deployed)",
                    f"Live URL: {app_url}",
                )
                if updated_readme != readme_text:
                    readme_path.write_text(updated_readme, encoding="utf-8")
            except OSError:
                pass
        workflow_path = project / ".workshop" / "design-workflow.json"
        if workflow_path.is_symlink() or workflow_path.parent.is_symlink():
            return
        now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(self.wall_time()))
        try:
            record = json.loads(workflow_path.read_text(encoding="utf-8")) if workflow_path.is_file() else {
                "schema": "workshop-design-workflow",
                "version": 1,
                "workflow_version": 2,
                "attendee": self.env.get("WORKSHOP_USER_EMAIL", ""),
                "project": project.name,
                "revision": 0,
                "brief_revision": 0,
                "phase": "build",
                "path": {"value": "rapid", "chosen_by": "attendee", "source": "chat", "at": now},
                "facts": [],
                "assumptions": [],
                "questions": [],
                "direction": None,
                "success_criteria": [],
                "evidence": {},
                "history": [],
                "requests": [],
                "outcome": None,
            }
            if not isinstance(record, dict) or record.get("schema") != "workshop-design-workflow":
                return
            if not (record.get("path") or {}).get("value"):
                record["path"] = {"value": "rapid", "chosen_by": "attendee", "source": "chat", "at": now}
            build_evidence = record.setdefault("evidence", {}).setdefault("build", {})
            build_evidence["preview"] = app_url
            build_evidence.setdefault("build", "deployed")
            previous_phase = record.get("phase") or "build"
            if previous_phase in {"understand", "choose_path", "shape", "agree", "build", "inspect", "improve"}:
                record["phase"] = "feedback"
                record.setdefault("history", []).append({
                    "at": now,
                    "event": "stage",
                    "from": previous_phase,
                    "to": "feedback",
                    "evidence": {"preview": app_url},
                    "brief_revision": record.get("brief_revision", 0),
                })
            record["revision"] = int(record.get("revision") or 0) + 1
            workflow_path.parent.mkdir(parents=True, exist_ok=True)
            fd, temporary = tempfile.mkstemp(prefix=".design-workflow-", dir=workflow_path.parent)
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as handle:
                    json.dump(record, handle, indent=2, sort_keys=True)
                    handle.write("\n")
                os.replace(temporary, workflow_path)
            finally:
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(temporary)
        except OSError:
            return

    def _result(
        self,
        state: dict[str, Any],
        status: str,
        reason: str,
        resumed: bool,
        call_started: float,
        *,
        message: str = "",
        remote_may_continue: bool = False,
    ) -> dict[str, Any]:
        return {
            "status": status,
            "reason": reason,
            "app_name": state.get("app_name", ""),
            "app_url": state.get("app_url", ""),
            "deployment_id": state.get("deployment_id", ""),
            "deployment_state": state.get("deployment_state", ""),
            "app_state": state.get("app_state", ""),
            "compute_state": state.get("compute_state", ""),
            "duration_ms": max(0, round((self.monotonic() - call_started) * 1000)),
            "attempts": int(state.get("attempts") or 0),
            "resumed": resumed,
            "remote_may_continue": remote_may_continue,
            "message": _safe_line(message),
        }


def _write_bounded(handle, line: str, written: int, truncated: bool) -> tuple[int, bool]:
    encoded = line.encode("utf-8", errors="replace")
    if written + len(encoded) <= MAX_LOG_BYTES:
        handle.write(encoded)
        handle.flush()
        return written + len(encoded), truncated
    if not truncated:
        marker = b"\n[workshop-app-deploy output truncated]\n"
        handle.write(marker)
        handle.flush()
        return written + len(marker), True
    return written, truncated


def submit_worker(args: argparse.Namespace, env: dict[str, str] | None = None) -> int:
    current_env = dict(os.environ if env is None else env)
    project = resolve_project_path(args.project, current_env)
    # The controller's recorded target, passed as-is: the worker never re-resolves it.
    target = normalize_target(args.target)
    log_path = Path(args.log_path).resolve()
    exit_path = Path(args.exit_path).resolve()
    log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    code = 127
    with log_path.open("ab", buffering=0) as log:
        os.chmod(log_path, 0o600)
        written = log.tell()
        truncated = False
        command = [
            "databricks",
            "apps",
            "deploy",
            *target_args(target),
            "--auto-approve",
            "--no-wait",
            "--output",
            "json",
        ]
        try:
            process = subprocess.Popen(
                command,
                cwd=project,
                env=_cli_env(current_env),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
            )
            assert process.stdout is not None
            for raw in iter(process.stdout.readline, b""):
                safe = _safe_line(raw.decode("utf-8", "replace"))
                written, truncated = _write_bounded(
                    log, f"{safe}\n", written, truncated
                )
            code = process.wait()
        except FileNotFoundError:
            written, truncated = _write_bounded(
                log, "The Databricks CLI is not installed\n", written, truncated
            )
        except Exception as exc:
            _write_bounded(log, f"Deploy submission failed: {_safe_line(exc)}\n", written, truncated)
    payload = {"exit_code": code, "worker_token": args.worker_token}
    fd, temporary = tempfile.mkstemp(prefix=".exit-", dir=exit_path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle)
            handle.write("\n")
        os.replace(temporary, exit_path)
        os.chmod(exit_path, 0o600)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)
    return code


class McpServer:
    def __init__(self, controller: DeployController):
        self.controller = controller
        self._write_lock = threading.Lock()
        self._calls_lock = threading.Lock()
        self._calls: dict[object, threading.Event] = {}

    def _send(self, value: dict[str, Any]) -> None:
        with self._write_lock:
            sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
            sys.stdout.flush()

    def _result(self, request_id: object, result: object) -> None:
        self._send({"jsonrpc": "2.0", "id": request_id, "result": result})

    def _error(self, request_id: object, code: int, message: str) -> None:
        self._send(
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "error": {"code": code, "message": _safe_line(message)},
            }
        )

    def _progress(self, token: object, message: str) -> None:
        if token is None:
            return
        self._send(
            {
                "jsonrpc": "2.0",
                "method": "notifications/progress",
                "params": {"progressToken": token, "progress": 0, "message": _safe_line(message)},
            }
        )

    def _tool(self) -> dict[str, Any]:
        return {
            "name": TOOL_NAME,
            "title": "Deploy Databricks App",
            "description": (
                "Deploy the single Databricks App in a workshop project, wait for "
                "the exact deployment and compute to become ready, and return its URL."
            ),
            "inputSchema": {
                "type": "object",
                "properties": {
                    "project_path": {
                        "type": "string",
                        "description": (
                            "Absolute App project directory under ~/projects (the folder with databricks.yml)."
                        ),
                    },
                    "target": {
                        "type": "string",
                        "description": (
                            "Bundle target name, passed to databricks apps deploy unchanged. "
                            "Omit it to use the bundle's default target."
                        ),
                    },
                    "timeout_seconds": {
                        "type": "integer",
                        "minimum": MIN_TIMEOUT_SECONDS,
                        "maximum": MAX_TIMEOUT_SECONDS,
                        "default": DEFAULT_TIMEOUT_SECONDS,
                    },
                },
                "required": ["project_path"],
                "additionalProperties": False,
            },
            "outputSchema": {
                "type": "object",
                "required": ["status", "reason", "app_name", "app_url", "resumed"],
                "properties": {
                    "status": {"type": "string"},
                    "reason": {"type": "string"},
                    "app_name": {"type": "string"},
                    "app_url": {"type": "string"},
                    "deployment_id": {"type": "string"},
                    "deployment_state": {"type": "string"},
                    "app_state": {"type": "string"},
                    "compute_state": {"type": "string"},
                    "duration_ms": {"type": "integer"},
                    "attempts": {"type": "integer"},
                    "resumed": {"type": "boolean"},
                    "remote_may_continue": {"type": "boolean"},
                    "message": {"type": "string"},
                    "entitlement_handoff": {"type": "string"},
                },
            },
            "annotations": {
                "title": "Deploy Databricks App",
                "readOnlyHint": False,
                "destructiveHint": False,
                "idempotentHint": True,
                "openWorldHint": True,
            },
        }

    def _call_tool(self, message: dict[str, Any]) -> None:
        request_id = message.get("id")
        params = message.get("params") or {}
        if not isinstance(params, dict):
            self._error(request_id, -32602, "Tool parameters must be an object")
            return
        name = params.get("name")
        if name != TOOL_NAME:
            self._error(request_id, -32602, f"Unknown tool: {name}")
            return
        arguments = params.get("arguments") or {}
        if not isinstance(arguments, dict):
            self._error(request_id, -32602, "Tool arguments must be an object")
            return
        try:
            arguments = collapse_project_path_aliases(arguments)
        except DeployError as exc:
            result = {
                "status": "failed",
                "reason": "invalid_request",
                "message": _safe_line(exc),
                "app_name": "",
                "app_url": "",
                "resumed": False,
            }
            self._result(
                request_id,
                {
                    "content": [{"type": "text", "text": json.dumps(result)}],
                    "structuredContent": result,
                    "isError": True,
                },
            )
            return
        allowed_arguments = {"project_path", "target", "timeout_seconds"}
        unknown_arguments = sorted(set(arguments) - allowed_arguments)
        if unknown_arguments:
            self._error(
                request_id,
                -32602,
                f"Unknown tool argument: {unknown_arguments[0]}",
            )
            return
        project_path = arguments.get("project_path")
        if not isinstance(project_path, str) or not project_path.strip():
            self._error(request_id, -32602, "project_path is required")
            return
        project_path = project_path.strip()
        if not Path(project_path).is_absolute():
            self._error(
                request_id,
                -32602,
                "project_path must be an absolute path",
            )
            return
        target = arguments.get("target")
        if target is not None and not isinstance(target, str):
            self._error(request_id, -32602, "target must be a string")
            return
        timeout_seconds = arguments.get("timeout_seconds", DEFAULT_TIMEOUT_SECONDS)
        if not isinstance(timeout_seconds, int) or isinstance(timeout_seconds, bool):
            self._error(request_id, -32602, "timeout_seconds must be an integer")
            return
        cancel = threading.Event()
        with self._calls_lock:
            self._calls[request_id] = cancel
        meta = params.get("_meta") or {}
        token = meta.get("progressToken") if isinstance(meta, dict) else None
        try:
            result = self.controller.deploy(
                project_path=project_path,
                target=target,
                timeout_seconds=timeout_seconds,
                cancel=cancel,
                progress=lambda message: self._progress(token, message),
                source="mcp",
            )
            payload = json.dumps(result, sort_keys=True)
            self._result(
                request_id,
                {
                    "content": [{"type": "text", "text": payload}],
                    "structuredContent": result,
                    "isError": result["status"] != "succeeded",
                },
            )
        except DeployError as exc:
            result = {
                "status": "failed",
                "reason": "invalid_request",
                "message": _safe_line(exc),
                "app_name": "",
                "app_url": "",
                "resumed": False,
            }
            self._result(
                request_id,
                {
                    "content": [{"type": "text", "text": json.dumps(result)}],
                    "structuredContent": result,
                    "isError": True,
                },
            )
        except Exception as exc:
            self._error(request_id, -32603, f"Deploy tool failed: {_safe_line(exc)}")
        finally:
            with self._calls_lock:
                self._calls.pop(request_id, None)

    def serve(self) -> int:
        workers: list[threading.Thread] = []
        for raw in sys.stdin:
            try:
                message = json.loads(raw)
            except json.JSONDecodeError:
                self._error(None, -32700, "Invalid JSON")
                continue
            method = message.get("method")
            request_id = message.get("id")
            if method == "initialize":
                requested = (message.get("params") or {}).get("protocolVersion")
                self._result(
                    request_id,
                    {
                        "protocolVersion": requested or "2025-06-18",
                        "capabilities": {"tools": {"listChanged": False}},
                        "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
                        "instructions": f"Use only {TOOL_NAME} for Databricks App deployment.",
                    },
                )
            elif method in {"notifications/initialized", "initialized"}:
                continue
            elif method == "ping":
                self._result(request_id, {})
            elif method == "tools/list":
                self._result(request_id, {"tools": [self._tool()]})
            elif method == "tools/call":
                thread = threading.Thread(
                    target=self._call_tool,
                    args=(message,),
                    daemon=True,
                    name=f"mcp-deploy-{request_id}",
                )
                workers.append(thread)
                thread.start()
            elif method == "notifications/cancelled":
                params = message.get("params") or {}
                with self._calls_lock:
                    event = self._calls.get(params.get("requestId"))
                if event is not None:
                    event.set()
            elif request_id is not None:
                self._error(request_id, -32601, f"Unknown method: {method}")
        with self._calls_lock:
            for event in self._calls.values():
                event.set()
        for worker in workers:
            worker.join(timeout=2.0)
        return 0


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Deploy one Databricks App and wait until its URL is live."
    )
    parser.add_argument("--mcp", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--project", default=".")
    parser.add_argument(
        "--target",
        default=None,
        help="bundle target, passed to the CLI unchanged; omit to use the bundle's default",
    )
    parser.add_argument("--timeout-seconds", type=int, default=DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--submit-worker", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--log-path", default="", help=argparse.SUPPRESS)
    parser.add_argument("--exit-path", default="", help=argparse.SUPPRESS)
    parser.add_argument("--worker-token", default="", help=argparse.SUPPRESS)
    parser.add_argument(
        "--declare-ai-gateway",
        default="",
        metavar="PROJECT",
        help="add the ai-gateway user scope to the project's app resources, then exit (no deploy)",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    if args.submit_worker:
        return submit_worker(args)
    if args.declare_ai_gateway:
        try:
            changed = declare_ai_gateway_in_project(Path(args.declare_ai_gateway))
        except (DeployError, OSError) as exc:
            print(f"workshop-app-deploy: {_safe_line(exc)}", file=sys.stderr)
            return 1
        except UnicodeDecodeError as exc:
            print(f"workshop-app-deploy: a bundle file is not UTF-8 text ({_safe_line(exc)})", file=sys.stderr)
            return 1
        if changed:
            print(f"ai-gateway scope declared in {', '.join(changed)}", file=sys.stderr)
        return 0
    if args.mcp:
        return McpServer(DeployController()).serve()
    cancel = threading.Event()

    def stop(_signum, _frame):
        cancel.set()

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    try:
        result = DeployController().deploy(
            project_path=args.project,
            target=args.target,
            timeout_seconds=args.timeout_seconds,
            cancel=cancel,
            progress=(lambda message: None) if args.json else print,
            source="cli",
        )
    except DeployError as exc:
        result = {"status": "failed", "reason": "invalid_request", "message": _safe_line(exc)}
    if args.json:
        print(json.dumps(result, sort_keys=True))
    elif result["status"] == "succeeded":
        print(f"App is live: {result['app_url']}")
        if result.get("message"):
            print(result["message"])
    else:
        print(
            f"Deploy {result['status']}: {result['reason']} "
            f"{result.get('message', '')}".rstrip(),
            file=sys.stderr,
        )
    return 0 if result["status"] == "succeeded" else (130 if result["status"] == "cancelled" else 1)


if __name__ == "__main__":
    raise SystemExit(main())
