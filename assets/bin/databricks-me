#!/usr/bin/env bash
# databricks-me — run the databricks CLI as YOU (the attendee), via the `me`
# profile backed by your on-behalf-of-user token. Use this to list/query the
# Unity Catalog catalogs, schemas, tables, and data you personally have access
# to (respects your grants, row filters, and column masks). Building and
# deploying still use the default service-principal profile.
#
# Generated by the workshop terminal — do not edit.
set -uo pipefail

PROFILE="${OBO_PROFILE_NAME:-me}"
APP="${WORKSHOP_APP_URL:-http://localhost:8000}"
EMAIL="${WORKSHOP_USER_EMAIL:-}"

_run() { databricks --profile "$PROFILE" "$@"; }
_is_auth_err() { printf '%s' "$1" | grep -Eqi '401|403|expired|invalid[_ ]?token|unauthor|default auth|cannot configure'; }

out="$(_run "$@" 2>&1)"; rc=$?
if [ $rc -ne 0 ] && _is_auth_err "$out"; then
  # Reactive self-heal: ask the app to write the freshest captured token and
  # nudge the browser tab, then retry once.
  curl -fsS -X POST "$APP/api/obo/refresh" \
    -H 'Content-Type: application/json' \
    -d "{\"email\":\"${EMAIL}\"}" >/dev/null 2>&1 || true
  sleep 2
  out="$(_run "$@" 2>&1)"; rc=$?
fi

printf '%s\n' "$out"
if [ $rc -ne 0 ] && _is_auth_err "$out"; then
  echo "" >&2
  echo "Your personal Databricks session may have expired — refresh the workshop tab in your browser, then retry. (Building and deploying still work normally on the default profile.)" >&2
fi
exit $rc
