#!/usr/bin/env bash
# workshop-discovery — record what you've learned about this attendee's use case
# so their Databricks account team can follow up after the event.
#
# Usage:
#   workshop-discovery '<json>'      # JSON object on the command line
#   workshop-discovery < record.json # or on stdin
#
# Fields (all optional except that you should set at least one):
#   record_id            stable id for THIS build. The helper keeps the build's id
#                        in .workshop/discovery.json and reuses it whichever agent
#                        is running, so one build is one record. Only New build
#                        starts another.
#   confidence           low | medium | high — how firmly THEY stated it
#   session_intent       business_problem | evaluation | learning | fun — why
#                        they were building. Always set it, including `fun` for
#                        a game: "a game" is an answer, an empty field is a gap.
#   use_case_title       short label
#   use_case_summary     two or three sentences
#   goal                 what they came here to do
#   current_stack        ["Kafka", "Oracle"] — tools they named
#   databricks_products  ["lakebase", "genie"]
#   blockers             ["no CDC from Oracle"] — in their words
#   interest_signals     ["asked about pricing for streaming"]
#   timeline             their words, e.g. "after our Q3 migration"
#   industry             if they said
#
# Record only what the attendee actually told you. Do not invent, and do not
# interrogate them to fill fields in — a partial record is expected and useful.
#
# Generated by the workshop terminal — do not edit.
set -uo pipefail

APP="${WORKSHOP_APP_URL:-http://localhost:8000}"
EMAIL="${WORKSHOP_USER_EMAIL:-}"
CAPABILITY_FILE="$HOME/.config/workshop/callback-capability"

if [ "$#" -gt 0 ]; then
  RECORD="$1"
else
  RECORD="$(cat)"
fi

if [ -z "${RECORD//[[:space:]]/}" ]; then
  echo "workshop-discovery: expected a JSON object as an argument or on stdin" >&2
  exit 2
fi

# One build, one record. A build's id lives in two places:
#   - its project folder, <project>/.workshop/discovery.json, once the folder exists;
#   - before that, ~/.config/workshop/discovery-pending.json, keyed by the active
#     build name ("" when there is none). A build never inherits another's id.
# The first capture after the folder appears moves the pending id into the folder.
read -r -d '' RESOLVE_PY <<'PY' || true
import json, os, subprocess
home = os.path.realpath(os.path.expanduser("~"))
cwd = os.path.realpath(os.getcwd())
conf = os.path.join(home, ".config", "workshop")


def read_json(path):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


projects = read_json(os.path.join(conf, "projects.json"))
active = str(projects.get("active", "") or "") if isinstance(projects, dict) else ""
active_dir = os.path.join(home, "projects", active) if active else ""
if not os.path.isdir(active_dir):
    active_dir = ""
if cwd in (home, os.path.join(home, "projects")):
    project = active_dir
else:
    project = ""
    try:
        top = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=10)
        if top.returncode == 0 and top.stdout.strip():
            project = top.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    project = project or cwd

pending_path = os.path.join(conf, "discovery-pending.json")
pending = read_json(pending_path)
builds = pending.get("builds", {}) if isinstance(pending, dict) else {}
builds = {str(k): str(v) for k, v in builds.items()} if isinstance(builds, dict) else {}
key = active
state = os.path.join(project, ".workshop", "discovery.json") if project else ""
adopt = None
if project:
    stored_file = read_json(state)
    stored = str(stored_file.get("record_id") or "") if isinstance(stored_file, dict) else ""
    if not stored:
        for candidate in (key, ""):
            if candidate in builds:
                adopt = candidate
                break
    record_id = stored or (builds[adopt] if adopt is not None else "")
else:
    record_id = builds.get(key, "")
print(json.dumps({"record_id": record_id, "state": state, "adopt": adopt,
                  "key": key, "pending": pending_path}))
PY

RESOLVED="$(python3 -c "$RESOLVE_PY")" || exit 2

# Merge the attendee identity in without a JSON parser dependency: the app
# authenticates the capability against this email, so it must be present and must
# not be something the agent can choose. The build's id replaces whatever the
# agent passed: one build, one record.
read -r -d '' PAYLOAD_PY <<'PY' || true
import json, os, sys
try:
    record = json.load(sys.stdin)
except Exception as exc:
    print(f"workshop-discovery: not valid JSON ({exc})", file=sys.stderr)
    raise SystemExit(2)
if not isinstance(record, dict):
    print("workshop-discovery: expected a JSON object", file=sys.stderr)
    raise SystemExit(2)
resolved = json.loads(sys.argv[1])
if resolved["record_id"]:
    record["record_id"] = resolved["record_id"]
record["email"] = os.environ.get("WORKSHOP_USER_EMAIL", "")
json.dump(record, sys.stdout)
PY

PAYLOAD="$(printf '%s' "$RECORD" | python3 -c "$PAYLOAD_PY" "$RESOLVED")" || exit 2

if RESPONSE="$(curl -fsS -X POST "$APP/api/discovery" \
     -H 'Content-Type: application/json' \
     -H "X-Workshop-Capability: $(<"$CAPABILITY_FILE")" \
     -d "$PAYLOAD")"; then
  # Capture may be switched off for this event; that is a normal answer, not a
  # failure, and nothing for the agent to retry or mention to the attendee.
  printf '%s\n' "$RESPONSE"
  # Keep the id of a captured record for this build, from any agent.
  read -r -d '' KEEP_PY <<'PY' || true
import json, os, sys
resolved = json.loads(sys.argv[1])
try:
    reply = json.load(sys.stdin)
except ValueError:
    raise SystemExit(0)
if not isinstance(reply, dict) or not reply.get("captured"):
    raise SystemExit(0)
record_id = str(reply.get("record_id") or "").strip()
if not record_id:
    raise SystemExit(0)


def read_json(path):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def write(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = path + ".tmp"
    with open(temporary, "w") as handle:
        json.dump(value, handle)
        handle.write("\n")
    os.replace(temporary, path)


if resolved["state"]:
    write(resolved["state"], {"record_id": record_id})
    if resolved["adopt"] is not None:
        pending = read_json(resolved["pending"])
        builds = pending.get("builds", {}) if isinstance(pending, dict) else {}
        if isinstance(builds, dict) and resolved["adopt"] in builds:
            del builds[resolved["adopt"]]
            write(resolved["pending"], {"builds": builds})
else:
    pending = read_json(resolved["pending"])
    builds = pending.get("builds", {}) if isinstance(pending, dict) else {}
    builds = builds if isinstance(builds, dict) else {}
    builds[resolved["key"]] = record_id
    write(resolved["pending"], {"builds": builds})
PY
  printf '%s' "$RESPONSE" | python3 -c "$KEEP_PY" "$RESOLVED" || true
else
  echo "workshop-discovery: could not reach the workshop app (capture may be off for this event)." >&2
  exit 1
fi
