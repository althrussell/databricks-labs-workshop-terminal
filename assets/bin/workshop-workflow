#!/usr/bin/env python3
"""The attendee's build workflow record: path, stage, decisions and evidence (W2).

Generated by the workshop terminal, do not edit. The record lives in the
project at ``.workshop/design-workflow.json`` and is committed with it, so any
agent (Claude, Codex, an Omnigent worker in a worktree) resumes from the same
state instead of repeating discovery. Who decided matters: only the attendee,
the wizard or a saved preference can choose a path, and only the attendee can
confirm a direction. An agent's own summary is never an approval.

    workshop-workflow show [--json]
    workshop-workflow path rapid|guided --by attendee|wizard|preference
    workshop-workflow phase <stage> [--evidence key=value ...]
    workshop-workflow fact|assume|ask|criterion "text"
    workshop-workflow answer <question-id> "text"
    workshop-workflow direction "summary" [--confirmed-by attendee]
    workshop-workflow check [--json]
    workshop-workflow verification [--json]
    workshop-workflow requests                  # changes/explanations the attendee asked for in the UI
    workshop-workflow done <request-id> "what you did"
    workshop-workflow prefs [--approach co_build|learn|lead] [--detail adaptive|brief|detailed]
                            [--default-path rapid|guided]
                            [--background domain|data|developer|exploring]
                            [--industry <industry>]

Every write takes ``--expect-revision N`` to refuse a stale update.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

SCHEMA = "workshop-design-workflow"
VERSION = 1
WORKFLOW_VERSION = 2
RECORD = ".workshop/design-workflow.json"
PHASES = ("understand", "choose_path", "shape", "agree", "build", "inspect", "improve", "feedback")
PATHS = ("rapid", "guided")
#: Who may choose a path. An agent's inference is not on this list.
CHOOSERS = ("attendee", "wizard", "preference")
TRANSITIONS = {
    "understand": {"choose_path"},
    "choose_path": {"shape", "agree", "build"},
    "shape": {"agree"},
    "agree": {"build", "shape"},
    "build": {"inspect", "feedback"},
    "inspect": {"improve", "feedback", "build"},
    "improve": {"inspect", "build", "feedback"},
    "feedback": {"improve", "build"},
}
#: Stages that claim something was built, and so need a path behind them.
BUILT = {"build", "inspect", "improve", "feedback"}
APPROACHES = ("co_build", "learn", "lead")
DETAILS = ("adaptive", "brief", "detailed")
BACKGROUNDS = ("domain", "data", "developer", "exploring")


class WorkflowError(Exception):
    """A refused write; exit status 2 (invalid) or 3 (stale)."""

    def __init__(self, message: str, status: int = 2):
        super().__init__(message)
        self.status = status


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def new_record(attendee: str = "", project: str = "") -> dict:
    return {
        "schema": SCHEMA, "version": VERSION, "workflow_version": WORKFLOW_VERSION,
        "attendee": attendee, "project": project, "revision": 0, "brief_revision": 0,
        "phase": "understand", "path": {"value": None, "chosen_by": None, "source": None, "at": None},
        "facts": [], "assumptions": [], "questions": [], "direction": None,
        "success_criteria": [], "evidence": {}, "history": [], "requests": [],
        # W6: the attendee's own account of the outcome, given at feedback.
        "outcome": None,
    }


def project_root(start: str | None = None) -> Path:
    cwd = Path(start or os.getcwd())
    if start is None:
        home = Path.home()
        if cwd.resolve() in {home.resolve(), (home / "projects").resolve()}:
            selection = home / ".config/workshop/projects.json"
            try:
                active = json.loads(selection.read_text()).get("active", "")
            except (OSError, ValueError, AttributeError):
                active = ""
            if active and (home / "projects" / active).is_dir():
                return (home / "projects" / active).resolve()
    try:
        top = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=10)
        if top.returncode == 0 and top.stdout.strip():
            return Path(top.stdout.strip())
    except (OSError, subprocess.TimeoutExpired):
        pass
    return cwd


def _is_scaffolded_build(project: Path | None) -> bool:
    return project is not None and (project / ".workshop/preparation.json").is_file()


def load(project: Path) -> dict:
    path = project / RECORD
    if not path.is_file():
        return new_record(os.environ.get("WORKSHOP_USER_EMAIL", ""), project.name)
    record = json.loads(path.read_text())
    if not isinstance(record, dict) or record.get("schema") != SCHEMA or record.get("version") != VERSION:
        raise WorkflowError(f"{RECORD} is not a version {VERSION} workflow record; repair it before continuing")
    # Additive migration: fields a newer record has are kept, missing ones defaulted.
    merged = new_record(record.get("attendee", ""), record.get("project", project.name))
    merged.update(record)
    return merged


def save(project: Path, record: dict, *, expected_revision: int | None, base_revision: int) -> dict:
    """Write atomically, refusing a write against a newer revision than the caller read."""
    path = project / RECORD
    current = load(project)
    if expected_revision is not None and current["revision"] != expected_revision:
        raise WorkflowError(f"the workflow record is now at revision {current['revision']}, not "
                            f"{expected_revision}; run `workshop-workflow show` and retry", 3)
    if current["revision"] != base_revision:
        raise WorkflowError("the workflow record changed while this update ran; retry", 3)
    attendee = os.environ.get("WORKSHOP_USER_EMAIL", "")
    if attendee and current.get("attendee") and current["attendee"].lower() != attendee.lower():
        raise WorkflowError("this workflow record belongs to another attendee's project")
    record["revision"] = current["revision"] + 1
    record["attendee"] = record.get("attendee") or attendee
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".design-workflow-", dir=path.parent)
    with os.fdopen(fd, "w") as handle:
        json.dump(record, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(temporary, path)
    return record


def _brief_changed(record: dict) -> None:
    record["brief_revision"] = record.get("brief_revision", 0) + 1


def choose_path(record: dict, value: str, *, by: str, source: str | None, project: Path | None = None) -> None:
    if value not in PATHS:
        raise WorkflowError(f"path must be one of {', '.join(PATHS)}")
    if by not in CHOOSERS:
        raise WorkflowError("only the attendee, the wizard or a saved preference chooses the path; "
                            "recommend one and ask instead")
    previous = record["path"].get("value")
    record["path"] = {"value": value, "chosen_by": by, "source": source, "at": now()}
    if previous and previous != value:
        # A switch keeps every confirmed fact and decision; only the route changes.
        record["history"].append({"at": now(), "event": "path_switched", "from": previous, "to": value, "by": by})
    if record["phase"] == "understand":
        record["phase"] = "choose_path"
    if _is_scaffolded_build(project) and record["phase"] in {"understand", "choose_path"}:
        if value == "rapid" or (value == "guided" and _direction_confirmed(record)):
            record["phase"] = "build"


def transition_problems(record: dict, target: str, evidence: dict) -> list[str]:
    problems = []
    current = record["phase"]
    if target not in PHASES:
        return [f"unknown stage {target!r}; stages are {', '.join(PHASES)}"]
    if target == current:
        return []
    if target != "choose_path" and target not in TRANSITIONS.get(current, set()):
        problems.append(f"{current} → {target} is not a workflow step")
    path = record["path"].get("value")
    if target in BUILT | {"shape", "agree"} and not path:
        problems.append("no path is chosen yet: recommend one and ask the attendee")
    if path == "guided" and target in BUILT and not _direction_confirmed(record):
        problems.append("guided ideation needs the attendee to confirm a direction before building")
    if path == "guided" and current == "choose_path" and target == "build":
        problems.append("guided ideation shapes and agrees a direction before building")
    if target == "inspect" and not ({"preview", "build"} & set(evidence)):
        problems.append("inspect needs build evidence: --evidence preview=<url> or build=<result>")
    if target == "feedback" and not (
        {"preview", "build"} & (set(evidence) | set(record.get("evidence", {}).get("build", {})))
    ):
        problems.append("feedback needs build evidence: --evidence preview=<url> or build=<result>")
    return problems


def _direction_confirmed(record: dict) -> bool:
    direction = record.get("direction")
    return isinstance(direction, dict) and direction.get("confirmed_by") == "attendee"


def _artifact_problems(record: dict, project: Path | None) -> list[str]:
    """Screenshots must still be the bytes that were captured (W3)."""
    if project is None:
        return []
    problems = []
    for artifact in record.get("evidence", {}).get("inspect", {}).get("artifacts", []):
        path = project / str(artifact.get("path", ""))
        try:
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
        except OSError:
            problems.append(f"screenshot {artifact.get('path')} is missing")
            continue
        if digest != artifact.get("sha256"):
            problems.append(f"screenshot {artifact.get('path')} no longer matches what was captured")
    return problems


def head_revision(project: Path) -> str:
    try:
        done = subprocess.run(["git", "-C", str(project), "rev-parse", "HEAD"], capture_output=True,
                              text=True, timeout=10)
        return done.stdout.strip() if done.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def verification(record: dict, project: Path | None = None) -> dict:
    """Review status, kept apart from the stage and from deployment (W4).

    ``verified``: screenshots of the current source revision exist and are
    intact. ``stale``: the reviewed surface changed since. ``unverified``: only
    gaps were recorded. ``none``: nothing was inspected.
    """
    inspect = record.get("evidence", {}).get("inspect", {})
    artifacts = [a for a in inspect.get("artifacts", []) if a.get("kind") == "screenshot"]
    gaps = inspect.get("gaps", [])
    if not artifacts:
        return {"state": "unverified" if gaps else "none", "gaps": [g.get("detail") or g.get("code") for g in gaps[-3:]]}
    latest = artifacts[-1]
    problems = _artifact_problems(record, project)
    head = head_revision(project) if project is not None else ""
    reviewed = (latest.get("revision") or {}).get("commit", "")
    stale = bool(problems) or bool(head and reviewed and head != reviewed)
    return {"state": "stale" if stale else "verified", "latest": latest.get("path"),
            "captured_at": latest.get("captured_at"), "scope": latest.get("scope"),
            "gaps": [g.get("detail") or g.get("code") for g in gaps[-3:]], "problems": problems}


def check(record: dict, project: Path | None = None) -> list[str]:
    """What makes the record's claims untrustworthy; empty when it is sound.

    A validator, not a judge: it checks context, transitions, evidence and
    truthful status. It cannot show that a model understood a document.
    """
    problems = []
    path = record.get("path") or {}
    phase = record.get("phase")
    if phase not in PHASES:
        problems.append(f"unknown stage {phase!r}")
    if path.get("value") and path.get("chosen_by") not in CHOOSERS:
        problems.append("the path was not chosen by the attendee, the wizard or a saved preference")
    if phase in BUILT | {"shape", "agree"} and not path.get("value"):
        problems.append(f"at {phase} with no chosen path")
    if path.get("value") == "guided" and phase in BUILT and not _direction_confirmed(record):
        problems.append("guided build without an attendee-confirmed direction")
    direction = record.get("direction")
    if isinstance(direction, dict) and direction.get("confirmed_by") not in (None, "attendee"):
        problems.append("a direction can only be confirmed by the attendee")
    for question in record.get("questions", []):
        if question.get("answer") is not None and question.get("answered_by") != "attendee":
            problems.append(f"question {question.get('id')} is marked answered without the attendee")
    evidence = record.get("evidence", {})
    problems.extend(_artifact_problems(record, project))
    if phase in {"inspect", "improve", "feedback"} and not ({"preview", "build"} & set(evidence.get("build", {}))):
        problems.append(f"at {phase} with no recorded build or preview")
    return problems


def _browser_enabled() -> bool:
    return os.environ.get("WORKSHOP_BROWSER_ENABLED", "").strip().lower() in {
        "1", "true", "yes", "on", "enabled", "enable",
    }


def next_step(record: dict) -> str:
    path, phase = record["path"].get("value"), record["phase"]
    waiting = [r for r in record.get("requests", []) if r.get("status") == "open"]
    if waiting:
        return f"handle the attendee's {waiting[0]['kind']} request [{waiting[0]['id']}]: {waiting[0]['text']}"
    if not path:
        return "recommend a path and ask once: rapid prototype or guided ideation"
    if path == "guided" and phase in {"choose_path", "shape"}:
        open_questions = [q for q in record["questions"] if q.get("answer") is None]
        return ("ask the open design questions" if open_questions
                else "present the brief and ask: build this direction, or refine it further?")
    if path == "guided" and phase == "agree" and not _direction_confirmed(record):
        return "wait for the attendee to confirm the direction"
    build_step = (
        "deploy, then inspect the desktop render with workshop-browser (desktop only, never phone/mobile)"
        if _browser_enabled()
        else "run apx dev check and apx build, deploy, and share the live preview URL with the attendee"
    )
    return {"choose_path": "confirm the MVP scope, Databricks building blocks and build plan with the attendee, then build",
            "agree": "build the agreed direction",
            "build": build_step,
            "inspect": "exercise the primary action on desktop and record what you checked",
            "improve": "show what changed and recheck", "feedback": "ask them to do their real task, then record their own account with `workshop-workflow outcome`"}.get(
        phase, "continue")


def summary(record: dict) -> str:
    path = record["path"]
    lines = [f"Workflow record (revision {record['revision']}, brief {record['brief_revision']}): "
             f"stage {record['phase']}, path {path.get('value') or 'not chosen'}"
             + (f" (chosen by {path.get('chosen_by')})" if path.get("value") else "")]
    for label, key in (("Confirmed facts", "facts"), ("Assumptions", "assumptions"),
                       ("Success criteria", "success_criteria")):
        items = record.get(key) or []
        if items:
            lines.append(f"{label}: " + "; ".join(item["text"] for item in items))
    open_questions = [q for q in record.get("questions", []) if q.get("answer") is None]
    if open_questions:
        lines.append("Open questions: " + "; ".join(f"[{q['id']}] {q['text']}" for q in open_questions))
    direction = record.get("direction")
    if direction:
        lines.append(f"Direction: {direction['text']} "
                     f"({'confirmed by the attendee' if _direction_confirmed(record) else 'NOT yet confirmed'})")
    lines.append("Next: " + next_step(record))
    return "\n".join(lines)


def _evidence(pairs: list[str]) -> dict:
    evidence = {}
    for pair in pairs:
        key, sep, value = pair.partition("=")
        if not sep or not key.strip():
            raise WorkflowError(f"evidence must be key=value, got {pair!r}")
        evidence[key.strip()] = value.strip()
    return evidence


def apply(record: dict, args: argparse.Namespace, *, project: Path | None = None) -> None:
    command = args.command
    by = getattr(args, "by", None) or "agent"
    if command == "path":
        choose_path(record, args.value, by=args.by, source=args.source, project=project)
    elif command == "phase":
        evidence = _evidence(args.evidence)
        problems = transition_problems(record, args.stage, evidence)
        if problems:
            raise WorkflowError("; ".join(problems))
        for key, value in evidence.items():
            # Build output and what was inspected are kept where check() reads them.
            if key == "gap":
                record["evidence"].setdefault("inspect", {}).setdefault("gaps", []).append(
                    {"kind": "gap", "code": "agent_reported", "detail": value, "at": now()})
                continue
            bucket = "build" if key in {"preview", "build"} else "inspect" if key == "checked" else args.stage
            record["evidence"].setdefault(bucket, {})[key] = value
        record["history"].append({"at": now(), "event": "stage", "from": record["phase"], "to": args.stage,
                                  "evidence": evidence, "brief_revision": record["brief_revision"]})
        record["phase"] = args.stage
    elif command in {"fact", "assume", "criterion"}:
        key = {"fact": "facts", "assume": "assumptions", "criterion": "success_criteria"}[command]
        entry = {"text": args.text, "by": by, "at": now()}
        if command == "fact" and by != "attendee":
            # Something the agent inferred is an assumption until they confirm it.
            key = "assumptions"
        record[key].append(entry)
        _brief_changed(record)
    elif command == "ask":
        question_id = f"q{len(record['questions']) + 1}"
        record["questions"].append({"id": question_id, "text": args.text, "answer": None,
                                    "answered_by": None, "at": now()})
        print(question_id)
    elif command == "answer":
        question = next((q for q in record["questions"] if q["id"] == args.id), None)
        if question is None:
            raise WorkflowError(f"no question {args.id}")
        question.update(answer=args.text, answered_by="attendee", answered_at=now())
        _brief_changed(record)
    elif command == "done":
        request = next((r for r in record.get("requests", []) if r["id"] == args.id), None)
        if request is None:
            raise WorkflowError(f"no request {args.id}")
        request.update(status="done", note=args.text, done_at=now())
    elif command == "outcome":
        # Their account, not the agent's guess: a deployed app whose owner is
        # still confused does not pass, and only they (or a facilitator who
        # watched them) can say whether it did.
        if record["phase"] != "feedback":
            raise WorkflowError("record the outcome at the feedback stage, after they have tried their real task")
        record["outcome"] = {"goal_explained": args.goal, "decisions_shaped": args.decisions,
                             "main_task": args.main_task, "second_change": args.second_change,
                             "knows_next_step": args.next_step, "confidence": args.confidence,
                             "by": args.by, "at": now(), "brief_revision": record["brief_revision"]}
        record["history"].append({"at": now(), "event": "outcome", "by": args.by})
    elif command == "direction":
        if args.confirmed_by not in (None, "attendee"):
            raise WorkflowError("only the attendee confirms a direction")
        record["direction"] = {"text": args.text, "confirmed_by": args.confirmed_by, "at": now()}
        if (
            args.confirmed_by == "attendee"
            and _is_scaffolded_build(project)
            and record["path"].get("value") == "guided"
            and record["phase"] in {"understand", "choose_path", "shape", "agree"}
        ):
            record["phase"] = "build"
        _brief_changed(record)


def _prefs(args: argparse.Namespace) -> int:
    """Save lasting preferences through the app's revision-checked profile service."""
    changes = {key: value for key, value in (("working_approach", args.approach),
                                              ("explanation_detail", args.detail),
                                              ("engagement_path", args.default_path),
                                              ("background", args.background),
                                              ("industry", args.industry)) if value}
    email = os.environ.get("WORKSHOP_USER_EMAIL", "")
    capability_file = Path.home() / ".config/workshop/callback-capability"
    app = os.environ.get("WORKSHOP_APP_URL", "http://localhost:8000").rstrip("/")
    if not email or not capability_file.is_file():
        print("workshop-workflow: preferences cannot be saved from here; ask them to use Agent preferences",
              file=sys.stderr)
        return 1

    def call(body: dict) -> dict:
        request = urllib.request.Request(
            app + "/api/agent/profile", method="POST", data=json.dumps({"email": email, **body}).encode(),
            headers={"Content-Type": "application/json",
                     "X-Workshop-Capability": capability_file.read_text().strip()})
        with urllib.request.urlopen(request, timeout=15) as response:
            return json.load(response)

    try:
        current = call({})
        if not changes:
            print(json.dumps(current, indent=2, sort_keys=True))
            return 0
        saved = call({"expected_revision": current["revision"], "changes": changes})
    except urllib.error.HTTPError as error:
        print(f"workshop-workflow: preferences not saved (HTTP {error.code}); nothing changed", file=sys.stderr)
        return 1
    except (urllib.error.URLError, OSError, ValueError, KeyError):
        print("workshop-workflow: could not reach the workshop app; preferences not saved", file=sys.stderr)
        return 1
    print("Saved: " + ", ".join(f"{key}={saved.get(key)}" for key in changes)
          + f" (profile revision {saved.get('revision')}). New agent turns use it.")
    demo = saved.get("industry_demo") or {}
    if args.industry and demo.get("catalog"):
        catalog = demo["catalog"]
        if demo.get("schema"):
            print(f"industry → {demo['schema']} ({catalog}.{demo['schema']}, {demo.get('tables', 0)} tables)."
                  f" Run SHOW TABLES IN {catalog}.{demo['schema']} before you plan.")
        elif not demo.get("readable"):
            print(f"{catalog} could not be listed just now; run SHOW SCHEMAS IN {catalog} and use the one"
                  " that is their industry.")
        else:
            print(f"no demo schema for '{args.industry}'; seeded: {', '.join(demo.get('seeded') or [])}"
                  " — re-run with --industry <schema> if one fits, otherwise generate labelled synthetic data")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="workshop-workflow", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--project", help="project directory (default: the git repository you are in)")
    parser.add_argument("--expect-revision", type=int)
    sub = parser.add_subparsers(dest="command", required=True)
    show = sub.add_parser("show")
    show.add_argument("--json", action="store_true")
    path = sub.add_parser("path")
    path.add_argument("value", choices=PATHS)
    path.add_argument("--by", required=True, choices=CHOOSERS)
    path.add_argument("--source", choices=("chat", "wizard", "profile"))
    phase = sub.add_parser("phase")
    phase.add_argument("stage", choices=PHASES)
    phase.add_argument("--evidence", action="append", default=[])
    for name in ("fact", "assume", "ask", "criterion"):
        entry = sub.add_parser(name)
        entry.add_argument("text")
        # Nothing is presumed attendee-confirmed: say --by attendee when they said it.
        entry.add_argument("--by", choices=("attendee", "agent"), default="agent")
    answer = sub.add_parser("answer")
    answer.add_argument("id")
    answer.add_argument("text")
    direction = sub.add_parser("direction")
    direction.add_argument("text")
    direction.add_argument("--confirmed-by", choices=("attendee",))
    outcome = sub.add_parser("outcome", help="the attendee's own account at feedback (never the agent's)")
    outcome.add_argument("--by", required=True, choices=("attendee", "facilitator"))
    for flag, choices in (("--goal", ("yes", "partly", "no")), ("--decisions", ("yes", "partly", "no")),
                          ("--main-task", ("yes", "partly", "no")), ("--second-change", ("made", "requested", "no")),
                          ("--next-step", ("yes", "no"))):
        outcome.add_argument(flag, required=True, choices=choices)
    outcome.add_argument("--confidence", type=int, choices=range(1, 6), required=True)
    sub.add_parser("requests")
    done = sub.add_parser("done")
    done.add_argument("id")
    done.add_argument("text")
    checker = sub.add_parser("check")
    checker.add_argument("--json", action="store_true")
    verify = sub.add_parser("verification")
    verify.add_argument("--json", action="store_true")
    prefs = sub.add_parser("prefs")
    prefs.add_argument("--approach", choices=APPROACHES)
    prefs.add_argument("--detail", choices=DETAILS)
    prefs.add_argument("--default-path", choices=PATHS)
    prefs.add_argument("--background", choices=BACKGROUNDS)
    prefs.add_argument("--industry")
    args = parser.parse_args(argv)

    if args.command == "prefs":
        return _prefs(args)
    project = Path(args.project).resolve() if args.project else project_root()
    try:
        record = load(project)
        if args.command == "show":
            print(json.dumps(record, indent=2, sort_keys=True) if args.json else summary(record))
            return 0
        if args.command == "requests":
            waiting = [r for r in record.get("requests", []) if r.get("status") == "open"]
            print("\n".join(f"[{r['id']}] {r['kind']}: {r['text']}" for r in waiting)
                  or "No open requests from the attendee.")
            return 0
        if args.command == "verification":
            state = verification(record, project)
            print(json.dumps(state, indent=2) if args.json else
                  f"Review: {state['state']}" + (f" ({state.get('latest')})" if state.get("latest") else "")
                  + ("; gaps: " + "; ".join(state["gaps"]) if state.get("gaps") else ""))
            return 0
        if args.command == "check":
            problems = check(record, project)
            if args.json:
                print(json.dumps({"ok": not problems, "problems": problems}, indent=2))
            else:
                print("\n".join(problems) or "Workflow record is consistent.")
            return 1 if problems else 0
        base = record["revision"]
        apply(record, args, project=project)
        saved = save(project, record, expected_revision=args.expect_revision, base_revision=base)
        print(summary(saved))
        return 0
    except WorkflowError as error:
        print(f"workshop-workflow: {error}", file=sys.stderr)
        return error.status
    except (OSError, ValueError) as error:
        print(f"workshop-workflow: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
