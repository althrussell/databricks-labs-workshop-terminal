#!/usr/bin/env python3
"""Zip attendee project source and verify its copy in the assigned UC volume."""

from __future__ import annotations

import argparse
import configparser
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time
from urllib.parse import quote
import uuid
import zipfile


VOLUME = "workshop_exports"
ARCHIVE_NAME_RE = re.compile(r"workshop-code-[A-Za-z0-9T._-]{1,100}\.zip")
RECEIPT_FILE = "latest.json"
SKIP_DIRS = frozenset({
    ".git", ".agents", ".claude", ".codex", ".databricks", ".workshop",
    "node_modules", ".venv", "venv", "__pycache__", ".cache", ".pytest_cache",
    ".ruff_cache", ".mypy_cache", ".next", ".nuxt", ".parcel-cache",
    "dist", "build", ".build", "__dist__", "coverage", ".ssh",
})
SKIP_FILES = frozenset({
    ".databrickscfg", ".netrc", ".npmrc", ".pypirc", "credentials.json",
    "id_rsa", "id_ed25519", ".DS_Store",
})
ENV_EXAMPLES = frozenset({".env.example", ".env.sample", ".env.template"})
_MANAGED_BEGIN = "<!-- workshop-managed:begin -->"
_MANAGED_END = "<!-- workshop-managed:end -->"


class ExportError(RuntimeError):
    pass


def excluded_file(name: str) -> bool:
    return (name in SKIP_FILES
            or (name.startswith(".env") and name not in ENV_EXAMPLES)
            or Path(name).suffix.lower() in {".pem", ".key", ".p12", ".pfx", ".pyc"})


def _strip_workshop_managed(text: str) -> str:
    """Remove workshop-managed instruction blocks while keeping attendee/scaffold notes."""
    if _MANAGED_BEGIN in text and _MANAGED_END in text:
        before, rest = text.split(_MANAGED_BEGIN, 1)
        _, after = rest.split(_MANAGED_END, 1)
        cleaned = (before.rstrip() + "\n\n" + after.lstrip()).strip()
        if cleaned.startswith("## Notes that were already in this project"):
            cleaned = cleaned.removeprefix("## Notes that were already in this project").strip()
        return (cleaned + "\n") if cleaned else ""
    if "<!-- workshop-project-memory -->" in text:
        return ""
    return text


def _walk_export_tree(source: Path, *, single_project: bool) -> tuple[list[tuple[str, Path | None, bytes | None]], list[str]]:
    """Collect (member_relpath, source_file_or_None, inline_utf8_bytes_or_None) and omitted paths."""
    entries: list[tuple[str, Path | None, bytes | None]] = []
    omitted: list[str] = []
    for directory, dirs, files in os.walk(source, followlinks=False):
        parent = Path(directory)
        for name in list(dirs):
            path = parent / name
            if name in SKIP_DIRS or path.is_symlink():
                dirs.remove(name)
                omitted.append(path.relative_to(source).as_posix() + "/")
                # Carry only the portable project goal, never the rest of
                # .workshop's runtime state. Do not follow either link.
                project_root = parent == source if single_project else parent.parent == source
                context = path / "project.json"
                if (name == ".workshop" and project_root and not path.is_symlink()
                        and context.is_file() and not context.is_symlink()):
                    relative = context.relative_to(source)
                    member = Path(source.name) / relative if single_project else relative
                    entries.append((member.as_posix(), context, None))
                evidence_dir = path / "evidence"
                if (name == ".workshop" and project_root and not path.is_symlink()
                        and evidence_dir.is_dir() and not evidence_dir.is_symlink()):
                    for shot in sorted(evidence_dir.glob("*.png")):
                        if shot.is_file() and not shot.is_symlink():
                            rel_project = parent.relative_to(source)
                            shot_member = (
                                Path(source.name) / "screenshots" / shot.name
                                if single_project
                                else rel_project / "screenshots" / shot.name
                            )
                            entries.append((shot_member.as_posix(), shot, None))
        dirs.sort()
        for name in sorted(files):
            path = parent / name
            relative = path.relative_to(source)
            if path.is_symlink() or excluded_file(name) or not path.is_file():
                omitted.append(relative.as_posix())
                continue
            member = Path(source.name) / relative if single_project else relative
            if name in {"AGENTS.md", "CLAUDE.md"}:
                raw_text = path.read_text(encoding="utf-8", errors="replace")
                stripped = _strip_workshop_managed(raw_text)
                if not stripped:
                    omitted.append(relative.as_posix())
                    continue
                if stripped != raw_text:
                    entries.append((member.as_posix(), None, stripped.encode("utf-8")))
                    continue
            entries.append((member.as_posix(), path, None))
    return entries, omitted


def source_fingerprint(projects_root: Path) -> str:
    """Deterministic SHA-256 over all exportable project content under ~/projects."""
    digest = hashlib.sha256()
    if projects_root.is_symlink() or not projects_root.is_dir():
        return digest.hexdigest()
    entries, omitted = _walk_export_tree(projects_root, single_project=False)
    for member, file_path, inline_bytes in entries:
        if inline_bytes is not None:
            content_hash = hashlib.sha256(inline_bytes).hexdigest()
        else:
            assert file_path is not None
            with file_path.open("rb") as handle:
                content_hash = hashlib.file_digest(handle, "sha256").hexdigest()
        digest.update(f"{member}:{content_hash}\n".encode("utf-8"))
    digest.update(("omitted:" + "|".join(omitted)).encode("utf-8"))
    return digest.hexdigest()


def build_archive(source: Path, destination: Path, *, single_project: bool) -> dict:
    """Include uncommitted/untracked source; never follow links outside a project."""
    entries, omitted = _walk_export_tree(source, single_project=single_project)
    if not entries:
        raise ExportError("No project source files were found to export.")
    included: list[str] = []
    with zipfile.ZipFile(destination, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for member, file_path, inline_bytes in entries:
            arcname = (Path("workshop-code") / member).as_posix()
            if inline_bytes is not None:
                archive.writestr(arcname, inline_bytes)
            else:
                assert file_path is not None
                archive.write(file_path, arcname=arcname)
            included.append(member)
        archive.writestr("workshop-code/EXPORT_INFO.txt", (
            "Workshop source export\n\n"
            "Contains current files, including uncommitted changes, tests, assets,\n"
            "dependency manifests/lockfiles, existing project notes and the\n"
            "portable .workshop/project.json goal when present.\n"
            "Git history, installed dependencies, generated builds, harness skills,\n"
            "environment/credential files and symlinks are excluded.\n"
            "Databricks resources and stored application data are not copied.\n"
            "Restore dependencies using each project's existing manifest/lockfile\n"
            "and configure access to your own Databricks workspace.\n\n"
            "Omitted paths:\n" + "\n".join(omitted) + "\n"
        ))
    return {"files": len(included), "omitted": omitted,
            "projects": sorted({Path(name).parts[0] for name in included})}


def cli_command() -> list[str]:
    # Export is build plumbing. CT's default coding identity has MANAGE on the
    # assigned catalog; the attendee's SQL/metadata OBO scopes exclude Volumes.
    return ["databricks"]


def run_cli(args: list[str], *, allow_failure: bool = False) -> subprocess.CompletedProcess:
    result = subprocess.run([*cli_command(), *args], capture_output=True, text=True)
    if result.returncode and not allow_failure:
        # Do not echo a subprocess's authentication/configuration output.
        reason = "Permission denied or session expired" if re.search(
            r"(?i)permission|unauthor|forbidden|expired|401|403", result.stderr + result.stdout
        ) else "Databricks operation failed"
        raise ExportError(f"{reason} during {' '.join(args[:2])}. "
                          "Return to the WT tab and retry, or ask the workshop organizer "
                          "to check access to your assigned catalog and schema.")
    return result


def ensure_self_privileges(kind: str, name: str, principal: str, required: set[str]) -> None:
    """Use CT's existing MANAGE grant, restricted to this export's namespace."""
    response = run_cli(["grants", "get-effective", kind, name,
                        "--principal", principal, "--output", "json"])
    assignments = json.loads(response.stdout).get("privilege_assignments", [])
    held = set()
    for assignment in assignments:
        if assignment.get("principal", "").casefold() == principal.casefold():
            for entry in assignment.get("privileges", []):
                held.add(entry.get("privilege") if isinstance(entry, dict) else entry)
    missing = required - held if "ALL_PRIVILEGES" not in held else set()
    if missing:
        body = json.dumps({"changes": [{"principal": principal, "add": sorted(missing)}]})
        run_cli(["grants", "update", kind, name, "--json", body, "--output", "json"])


def namespace() -> tuple[str, str]:
    catalog = os.environ.get("WORKSHOP_CATALOG", "").strip()
    schema = os.environ.get("WORKSHOP_SCHEMA", "").strip()
    if not catalog or not schema:
        raise ExportError("The assigned WORKSHOP_CATALOG and WORKSHOP_SCHEMA are required. "
                          "Ask the workshop organizer to configure them; no default catalog is guessed.")
    for value in (catalog, schema):
        if not re.fullmatch(r"[\w-]+", value):
            raise ExportError("The assigned catalog/schema contains an unsupported path character.")
    return catalog, schema


def upload_archive(archive: Path, catalog: str, schema: str) -> str:
    schema_name = f"{catalog}.{schema}"
    run_cli(["schemas", "get", schema_name, "--output", "json"])
    identity = json.loads(run_cli(["current-user", "me", "--output", "json"]).stdout)
    principal = identity.get("userName")
    if not isinstance(principal, str) or not principal.strip():
        raise ExportError("The coding identity could not be determined; no permissions were changed.")
    ensure_self_privileges("schema", schema_name, principal, {"USE_SCHEMA", "CREATE_VOLUME"})
    volume_name = f"{catalog}.{schema}.{VOLUME}"
    existing = run_cli(["volumes", "read", volume_name, "--output", "json"], allow_failure=True)
    if existing.returncode:
        # Create only in the existing, CT-assigned schema. An existing volume
        # race is reconciled by read; every other failure is reported.
        created = run_cli(["volumes", "create", catalog, schema, VOLUME, "MANAGED",
                           "--comment", "Workshop source ZIPs: download before event teardown.",
                           "--output", "json"], allow_failure=True)
        if created.returncode:
            run_cli(["volumes", "read", volume_name, "--output", "json"])
    ensure_self_privileges("volume", volume_name, principal, {"READ_VOLUME", "WRITE_VOLUME"})
    folder = f"/Volumes/{catalog}/{schema}/{VOLUME}/code"
    path = f"{folder}/{archive.name}"
    run_cli(["fs", "mkdirs", "dbfs:" + folder])
    run_cli(["fs", "cp", str(archive), "dbfs:" + path])
    with tempfile.TemporaryDirectory(prefix=".verify-", dir=archive.parent) as temporary:
        downloaded = Path(temporary) / archive.name
        run_cli(["fs", "cp", "dbfs:" + path, str(downloaded)])
        with archive.open("rb") as local, downloaded.open("rb") as remote:
            matches = hashlib.file_digest(local, "sha256").digest() == hashlib.file_digest(remote, "sha256").digest()
        if not matches:
            raise ExportError("The uploaded ZIP did not match the local ZIP. The local copy is retained.")
    return path


def workspace_host() -> str:
    host = os.environ.get("DATABRICKS_HOST", "").strip()
    if not host:
        config = configparser.ConfigParser(interpolation=None)
        config.read(Path.home() / ".databrickscfg")
        profile = os.environ.get("OBO_PROFILE_NAME") or os.environ.get("DATABRICKS_CONFIG_PROFILE", "DEFAULT")
        host = config.get(profile, "host", fallback="")
    return host.rstrip("/")


def upload_screenshots(source: Path, catalog: str, schema: str, *, single_project: bool) -> list[str]:
    uploaded: list[str] = []
    candidates = [source] if single_project else [
        child for child in sorted(source.iterdir())
        if child.is_dir() and not child.is_symlink() and not child.name.startswith(".")
    ]
    shots: list[tuple[str, Path]] = []
    for proj in candidates:
        evidence = proj / ".workshop" / "evidence"
        if evidence.is_dir() and not evidence.is_symlink():
            pngs = [p for p in sorted(evidence.glob("*.png")) if p.is_file() and not p.is_symlink()]
            if pngs:
                shots.append((proj.name, pngs[-1]))
    if not shots:
        return uploaded
    folder = f"/Volumes/{catalog}/{schema}/{VOLUME}/screenshots"
    run_cli(["fs", "mkdirs", "dbfs:" + folder], allow_failure=True)
    for proj_name, png in shots:
        dest = f"{folder}/{proj_name}-{png.name}"
        cp_res = run_cli(["fs", "cp", str(png), "dbfs:" + dest], allow_failure=True)
        if cp_res.returncode == 0:
            uploaded.append(dest)
    return uploaded


def _safe_cache_dir() -> Path | None:
    """Return ~/.cache/workshop/exports only when no segment beneath HOME is a symlink."""
    home = Path.home()
    cur = home
    for part in (".cache", "workshop", "exports"):
        cur = cur / part
        if cur.is_symlink() or (cur.exists() and not cur.is_dir()):
            return None
    return cur


def _write_latest_receipt(cache: Path, payload: dict) -> None:
    if _safe_cache_dir() is None:
        return
    fd, tmp_name = tempfile.mkstemp(prefix=".latest-", suffix=".json", dir=cache)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle)
        os.replace(tmp_name, cache / RECEIPT_FILE)
    except OSError:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass


def _read_reusable_receipt(
    cache: Path,
    projects: Path,
    *,
    single_project: bool,
    project_name: str | None,
    max_age_seconds: int,
) -> dict | None:
    if max_age_seconds <= 0 or _safe_cache_dir() is None:
        return None
    receipt_path = cache / RECEIPT_FILE
    if receipt_path.is_symlink() or not receipt_path.is_file():
        return None
    try:
        if receipt_path.stat().st_size > 65536:
            return None
        saved = json.loads(receipt_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(saved, dict):
        return None
    at = saved.get("at")
    if not isinstance(at, (int, float)) or isinstance(at, bool):
        return None
    age = time.time() - float(at)
    if age < -1.0 or age > max_age_seconds:
        return None
    receipt = saved.get("receipt")
    if not isinstance(receipt, dict) or receipt.get("verified") is not True:
        return None
    if single_project:
        if saved.get("single_project") is not True or saved.get("project") != project_name:
            return None
    filename = str(receipt.get("filename") or "")
    archive = cache / filename
    if (not ARCHIVE_NAME_RE.fullmatch(filename)
            or str(archive) != str(receipt.get("local_zip") or "")
            or archive.is_symlink() or not archive.is_file()):
        return None
    if source_fingerprint(projects) != saved.get("workspace_fingerprint"):
        return None
    try:
        with archive.open("rb") as handle:
            zip_sha256 = hashlib.file_digest(handle, "sha256").hexdigest()
    except OSError:
        return None
    if zip_sha256 != saved.get("zip_sha256"):
        return None
    return {**receipt, "reused": True}


def export(project: str | None = None, *, reuse_recent_seconds: int = 0) -> dict:
    catalog, schema = namespace()
    projects = Path.home() / "projects"
    source = Path(project).expanduser().absolute() if project else projects
    if source.is_symlink() or not source.is_dir():
        raise ExportError("The project source directory does not exist or is a symlink.")
    if not source.resolve().is_relative_to(projects.resolve()):
        raise ExportError("Export a project inside your ~/projects directory.")
    single_project = project is not None
    cache = Path.home() / ".cache/workshop/exports"
    reused = _read_reusable_receipt(
        cache,
        projects,
        single_project=single_project,
        project_name=source.name if single_project else None,
        max_age_seconds=reuse_recent_seconds,
    )
    if reused is not None:
        return reused
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    archive = cache / f"workshop-code-{stamp}-{uuid.uuid4().hex[:8]}.zip"
    # A local copy survives an upload/authentication failure; it is outside the
    # source tree so repeat exports never recursively include previous ZIPs.
    archive.touch(mode=0o600, exist_ok=False)
    workspace_fp = source_fingerprint(projects)
    result = build_archive(source, archive, single_project=single_project)
    try:
        path = upload_archive(archive, catalog, schema)
    except (ExportError, OSError, ValueError) as error:
        raise ExportError(f"{error}\nLocal ZIP retained at {archive}") from None
    screenshots = upload_screenshots(source, catalog, schema, single_project=single_project)
    host = workspace_host()
    receipt = {**result, "local_zip": str(archive), "volume_path": path,
               "screenshots": screenshots,
               "volume": f"{catalog}.{schema}.{VOLUME}", "filename": archive.name,
               "verified": True, "reused": False,
               "volume_url": (host + "/explore/data/volumes/" + "/".join(
                   quote(part, safe="") for part in (catalog, schema, VOLUME)
               )) if host else ""}
    with archive.open("rb") as handle:
        zip_sha256 = hashlib.file_digest(handle, "sha256").hexdigest()
    _write_latest_receipt(cache, {
        "at": time.time(),
        "single_project": single_project,
        "project": source.name if single_project else None,
        "workspace_fingerprint": workspace_fp,
        "zip_sha256": zip_sha256,
        "receipt": receipt,
    })
    return receipt


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project", help="Export one project; otherwise export all of ~/projects")
    parser.add_argument("--reuse-recent", type=int, default=0,
                        help="Reuse the latest verified export within N seconds if ~/projects is unchanged")
    parser.add_argument("--json", action="store_true", help="Return the verified export receipt as JSON")
    args = parser.parse_args()
    try:
        result = export(args.project, reuse_recent_seconds=args.reuse_recent)
    except (ExportError, OSError, configparser.Error) as error:
        print(f"workshop-export: {error}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(result))
    else:
        print(f"Exported {result['files']} source files. Uploaded ZIP read-back matches the local ZIP.")
        print(f"Volume: {result['volume']}\nZIP: {result['volume_path']}")
        print("Download to your computer before the workshop environment is deleted:")
        print("1. Click Download my code in the Workshop Terminal header.")
        print(f"2. For {result['filename']}, your browser saves the ZIP; unzip it on your computer.")
        print("3. If it says your sign-in ended, reload this tab and click again.")
        print("The Volume is temporary workshop storage; the downloaded ZIP is your take-home copy.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
