#!/usr/bin/env bash
# Workshop project bootstrap — generated by the workshop terminal, do not edit.
#
# Creates (or adopts) a project under ~/projects with the workshop's AppKit
# mandate committed as BOTH CLAUDE.md and AGENTS.md. Committing matters:
# Omnigent delegates coding to sub-agents that run in `git worktree`s under an
# isolated CODEX_HOME, so they never see ~/.codex/AGENTS.md — only a tracked,
# project-level AGENTS.md propagates into a worktree. This makes the mandate
# reach every agent and harness regardless of which home/config dir it uses.
#
# Why it can also run the AppKit scaffold (--appkit):
#
#   `databricks apps init` refuses to write into a directory that already
#   exists, and it always creates a subdirectory named after the app inside
#   --output-dir. So "make the project, then scaffold into it" cannot work: the
#   scaffold either errors, or lands in <project>/<project> and has to be
#   flattened by hand. That hand-flatten is the dangerous step — `mv` over the
#   project root silently replaces the committed CLAUDE.md with the scaffold's
#   generic one, taking the workshop's rules with it.
#
#   Doing both here closes the window. There is no intermediate state for a
#   `mv` to exist in, and the seeding below never destroys a file it did not
#   write.
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: workshop-init-project <project-name> [--appkit [-- <databricks apps init flags>]]

  <project-name>   created (or adopted) at ~/projects/<project-name>
  --appkit         scaffold an AppKit app into it first, without nesting
  --               everything after this is passed through to `databricks apps init`

examples:
  workshop-init-project my-app --appkit
  workshop-init-project my-app --appkit -- --features analytics
  workshop-init-project my-notes            # no scaffold, just the project
USAGE
}

NAME=""
APPKIT=0
PASSTHRU=()

while [ $# -gt 0 ]; do
  case "$1" in
    --appkit) APPKIT=1; shift ;;
    --) shift; PASSTHRU=("$@"); break ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "workshop-init-project: unknown flag $1" >&2; usage; exit 2 ;;
    *)
      if [ -n "$NAME" ]; then
        echo "workshop-init-project: unexpected argument $1" >&2
        usage; exit 2
      fi
      NAME="$1"; shift ;;
  esac
done

if [ -z "$NAME" ]; then
  usage
  exit 2
fi

PROJECTS="${HOME}/projects"
DEST="${PROJECTS}/${NAME}"
TEMPLATE="${HOME}/.config/workshop/project-memory.md"
# The template carries this marker so re-running the helper (or adopting a
# project it already seeded) is a no-op rather than a second copy.
MARKER="<!-- workshop-project-memory -->"

mkdir -p "$PROJECTS"

if [ "$APPKIT" = "1" ] && [ ! -e "$DEST" ]; then
  # --output-dir is the PARENT: this produces ~/projects/<name> directly, which
  # is the whole point — no <name>/<name> to flatten afterwards.
  #
  # A scaffold failure (npm, network, a bad --features) must not cost the
  # attendee their project. Seeding below still runs, so they get a git repo
  # with the workshop's rules in it and the agent can retry the scaffold in
  # place — which now works, because seeding never leaves a file the scaffold
  # would refuse to overwrite... except the directory itself, so say so.
  if ! databricks apps init --name "$NAME" --output-dir "$PROJECTS" \
       "${PASSTHRU[@]+"${PASSTHRU[@]}"}"; then
    echo "workshop-init-project: AppKit scaffold failed — continuing with a" >&2
    echo "  plain project. To retry the scaffold, run it into a clean name:" >&2
    echo "    databricks apps init --name ${NAME} --output-dir ${PROJECTS}" >&2
    echo "  (it will not write into ${DEST} once that directory exists)" >&2
  fi
fi

mkdir -p "$DEST"
cd "$DEST"

if [ ! -d .git ]; then
  git init -q
fi

# --- Seeding: additive only ---------------------------------------------------
# Every write below either creates a file or appends to one. Nothing here
# replaces content someone else wrote, because the file this most often collides
# with — CLAUDE.md — is the one carrying the workshop's rules.

if [ -f "$TEMPLATE" ]; then
  if [ ! -f AGENTS.md ]; then
    cp "$TEMPLATE" AGENTS.md
  fi

  if [ ! -f CLAUDE.md ]; then
    cp "$TEMPLATE" CLAUDE.md
  elif ! grep -q "$MARKER" CLAUDE.md 2>/dev/null; then
    # A scaffold (or the attendee) got here first. The workshop rules go on top
    # because they are authoritative, and the existing content is kept below
    # rather than discarded — the AppKit notes a scaffold writes are worth
    # having, they are just not the thing that decides how we build.
    EXISTING="$(cat CLAUDE.md)"
    {
      cat "$TEMPLATE"
      printf '\n\n## Notes that were already in this project\n\n'
      printf 'Kept verbatim from the file that existed when the workshop set this\n'
      printf 'project up (usually the AppKit scaffold). The rules above win on any\n'
      printf 'conflict.\n\n'
      printf '%s\n' "$EXISTING"
    } > CLAUDE.md
  fi
  git add AGENTS.md CLAUDE.md
fi

# A README, always. The agent is told to keep it current (one line on what the
# app is for, plus the live URL), and it is the attendee's take-home reminder of
# what they built once the workspace is torn down. If a scaffold already wrote
# one, its content stays and the two prompts are appended.
if [ ! -f README.md ]; then
  cat > README.md <<EOF
# ${NAME}

_What this is for:_ (one line — the agent fills this in as soon as it knows)

_Live URL:_ (added once the app is deployed)
EOF
elif ! grep -q "_Live URL:_" README.md 2>/dev/null; then
  cat >> README.md <<'EOF'

_What this is for:_ (one line — the agent fills this in as soon as it knows)

_Live URL:_ (added once the app is deployed)
EOF
fi

git add -A
# Tolerate a commit failure (e.g. missing git identity): the attendee still gets
# a working project directory with the files staged, which is far better than
# aborting project creation outright.
git commit -q -m "Workshop bootstrap: project memory (CLAUDE.md + AGENTS.md) and README" || true

# Print the path so the caller can `cd` into the new project.
echo "$DEST"
