#!/usr/bin/env bash
# Workshop project bootstrap — generated by the workshop terminal, do not edit.
#
# Creates a new project under ~/projects with the workshop's AppKit mandate
# committed as BOTH CLAUDE.md and AGENTS.md. Committing matters: Omnigent
# delegates coding to sub-agents that run in `git worktree`s under an isolated
# CODEX_HOME, so they never see ~/.codex/AGENTS.md — only a tracked,
# project-level AGENTS.md propagates into a worktree. This makes the mandate
# reach every agent and harness regardless of which home/config dir it uses.
set -euo pipefail

NAME="${1:-}"
if [ -z "$NAME" ]; then
  echo "usage: workshop-init-project <project-name>" >&2
  exit 2
fi

DEST="${HOME}/projects/${NAME}"
TEMPLATE="${HOME}/.config/workshop/project-memory.md"

if [ -e "$DEST" ]; then
  echo "workshop-init-project: ${DEST} already exists" >&2
  exit 1
fi

mkdir -p "$DEST"
cd "$DEST"
git init -q

if [ -f "$TEMPLATE" ]; then
  cp "$TEMPLATE" AGENTS.md
  cp "$TEMPLATE" CLAUDE.md
  git add AGENTS.md CLAUDE.md
  git commit -q -m "Workshop bootstrap: AppKit project memory (CLAUDE.md + AGENTS.md)"
fi

# Print the path so the caller can `cd` into the new project.
echo "$DEST"
