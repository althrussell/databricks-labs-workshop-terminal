#!/usr/bin/env bash
# Workshop project bootstrap — generated by the workshop terminal, do not edit.
#
# Creates (or adopts) a project under ~/projects with the workshop contract
# committed as BOTH CLAUDE.md and AGENTS.md. Committing matters:
# Omnigent delegates coding to sub-agents that run in `git worktree`s under an
# isolated CODEX_HOME, so they never see ~/.codex/AGENTS.md — only a tracked,
# project-level AGENTS.md propagates into a worktree. This makes the contract
# reach every agent and harness regardless of which home/config dir it uses.
#
# Why it can also run the AppKit scaffold (--appkit):
#
#   `databricks apps init` refuses to write into a directory that already
#   exists, and it always creates a subdirectory named after the app inside
#   --output-dir. So "make the project, then scaffold into it" cannot work: the
#   scaffold either errors, or lands in <project>/<project> and has to be
#   flattened by hand. That hand-flatten is the dangerous step — `mv` over the
#   project root silently replaces the committed CLAUDE.md with the scaffold's
#   generic one, taking the workshop's rules with it.
#
#   Doing both here closes the window. There is no intermediate state for a
#   `mv` to exist in, and the seeding below never destroys a file it did not
#   write.
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: workshop-init-project <project-name> [--apx | --appkit | --agentbricks] [--json] [-- <scaffold flags>]

  <project-name>   created (or adopted) at ~/projects/<project-name>
  --apx            scaffold the default React + FastAPI app with official APX
  --appkit         scaffold an AppKit app into it first, without nesting
  --agentbricks    scaffold a custom-agent backend with the Agent Bricks CLI
  --json           return preparation status (nonzero when incomplete)
  --               remaining arguments go to the selected scaffolder

examples:
  workshop-init-project my-app --apx
  workshop-init-project my-app --appkit
  workshop-init-project my-app --appkit -- --features analytics
  workshop-init-project my-notes            # no scaffold, just the project
  workshop-init-project my-agent --agentbricks -- --framework openai
USAGE
}

NAME=""
APPKIT=0
APX=0
AGENTBRICKS=0
JSON=0
SCAFFOLD="not_requested"
PASSTHRU=()

while [ $# -gt 0 ]; do
  case "$1" in
    --appkit) APPKIT=1; shift ;;
    --apx) APX=1; shift ;;
    --agentbricks) AGENTBRICKS=1; shift ;;
    --json) JSON=1; shift ;;
    --) shift; PASSTHRU=("$@"); break ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "workshop-init-project: unknown flag $1" >&2; usage; exit 2 ;;
    *)
      if [ -n "$NAME" ]; then
        echo "workshop-init-project: unexpected argument $1" >&2
        usage; exit 2
      fi
      NAME="$1"; shift ;;
  esac
done

if [ -z "$NAME" ]; then
  usage
  exit 2
fi
if [[ ! "$NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$ ]]; then
  echo "workshop-init-project: use a project name of 1-63 letters, numbers, underscores or hyphens, starting with a letter or number" >&2
  exit 2
fi
if [ $((APPKIT + APX + AGENTBRICKS)) -gt 1 ]; then
  echo "workshop-init-project: choose one scaffold per project" >&2
  exit 2
fi

PROJECTS="${HOME}/projects"
DEST="${PROJECTS}/${NAME}"
TEMPLATE="${HOME}/.config/workshop/project-memory.md"
APPKIT_VERSION="${APPKIT_VERSION:-0.87.0}"

mkdir -p "$PROJECTS"
CREATED=0
if [ ! -e "$DEST" ]; then
  CREATED=1
fi
if [ -L "$DEST" ] || { [ -e "$DEST" ] && [ ! -d "$DEST" ]; }; then
  echo "workshop-init-project: target must be a project directory, not a symlink or file" >&2
  exit 2
fi
if [ -d "$DEST" ]; then
  SCAFFOLD="adopted"
fi

if [ "$APX" = "1" ]; then
  if ! command -v apx >/dev/null || ! command -v uv >/dev/null || ! command -v bun >/dev/null; then
    echo "workshop-init-project: APX, Bun and uv are not ready; check WT setup status and retry" >&2
    exit 1
  fi
  if [ ! -e "$DEST" ]; then
    # Explicit profile/addons avoid interactive setup and an imposed sidebar.
    # WT projects receive both framework skills below. Do not enable APX's
    # assistant addon: it adds a separate @latest browser MCP and hooks.
    set +e
    apx init "$DEST" --name "$NAME" --profile "${DATABRICKS_CONFIG_PROFILE:-DEFAULT}" \
      --addons ui "${PASSTHRU[@]+"${PASSTHRU[@]}"}" >&2
    SCAFFOLD_STATUS=$?
    set -e
    if [ "$SCAFFOLD_STATUS" -ne 0 ]; then
      SCAFFOLD="failed"
      echo "workshop-init-project: APX scaffold failed; retain the project and fix the reported error before building" >&2
    else
      SCAFFOLD="complete"
      # APX 0.3.8's fresh lifespan template uses an annotation deprecated by
      # current ty. Correct only the new scaffold; never rewrite attendee code.
      python3 - "$DEST" <<'PY'
from pathlib import Path
import sys

for path in Path(sys.argv[1]).glob('src/*/backend/core/_factory.py'):
    original = path.read_text()
    updated = original.replace('from collections.abc import AsyncIterator',
                               'from collections.abc import AsyncGenerator')
    updated = updated.replace(') -> AsyncIterator[None]:',
                              ') -> AsyncGenerator[None, None]:')
    if updated != original:
        path.write_text(updated)
PY
    fi
  elif ! grep -q '\[tool.apx' "$DEST/pyproject.toml" 2>/dev/null; then
    echo "workshop-init-project: existing project is not APX; keep its framework or choose a clean name" >&2
    exit 1
  fi
fi

if [ "$AGENTBRICKS" = "1" ]; then
  if ! command -v agentbricks >/dev/null || ! command -v uv >/dev/null; then
    echo "workshop-init-project: Agent Bricks CLI and uv are not ready; ask the facilitator to enable/qualify AGENTBRICKS_ENABLED" >&2
    exit 1
  fi
  if [ ! -e "$DEST" ]; then
    # Scaffold BEFORE git/memory seeding: the CLI refuses an existing directory.
    # Use the already provisioned profile; this path needs no login or credentials.
    # API-only keeps the upstream demo UI from replacing the workshop UX baseline.
    AGENT_PROFILE="${DATABRICKS_CONFIG_PROFILE:-DEFAULT}"
    agentbricks --profile "$AGENT_PROFILE" init --profile "$AGENT_PROFILE" --disable-chat-app \
      "$DEST" "${PASSTHRU[@]+"${PASSTHRU[@]}"}" >&2
    SCAFFOLD="complete"
  elif [ ! -f "$DEST/agent.toml" ]; then
    echo "workshop-init-project: existing project has no agent.toml; choose a clean name or use the Agent Bricks migration workflow" >&2
    exit 1
  fi
fi

if [ "$APPKIT" = "1" ] && [ ! -e "$DEST" ]; then
  # --output-dir is the PARENT: this produces ~/projects/<name> directly, which
  # is the whole point — no <name>/<name> to flatten afterwards.
  #
  # A scaffold failure (npm, network, a bad --features) must not cost the
  # attendee their project. Seeding below still runs, so they get a git repo
  # with the workshop's rules in it and the agent can retry the scaffold in
  # place — which now works, because seeding never leaves a file the scaffold
  # would refuse to overwrite... except the directory itself, so say so.
  # The scaffolder checks for skills installed its own way (`databricks aitools
  # install`) and warns twice when it finds none. In this terminal that premise
  # is false: the workshop ships a curated, trimmed skill set into ~/.claude
  # already, and installing a second copy on top would be duplication, not a
  # fix. A warning that fires when its own premise is false teaches everyone
  # reading it — attendee and agent alike — to skim past warnings, so drop
  # those two lines and leave every other line of scaffold output intact on
  # stderr. stdout is exclusively the final project path: callers use it in
  # command substitution, including `cd "$(workshop-init-project ... --appkit)"`.
  #
  # PIPESTATUS, not the pipeline status: grep exits non-zero when it filters
  # everything out, and that must not read as a failed scaffold. `set +e` around
  # it because the status is inspected below rather than aborting here, and
  # PIPESTATUS has to be read before any other command runs.
  set +e
  databricks apps init --version "$APPKIT_VERSION" --package-manager npm \
    --name "$NAME" --output-dir "$PROJECTS" \
    "${PASSTHRU[@]+"${PASSTHRU[@]}"}" 2>&1 \
    | grep -vF \
        -e "Databricks skills are not installed" \
        -e "coding agents detected without Databricks skills" >&2
  SCAFFOLD_STATUS=${PIPESTATUS[0]}
  set -e

  if [ "$SCAFFOLD_STATUS" -ne 0 ]; then
    SCAFFOLD="failed"
    echo "workshop-init-project: AppKit scaffold failed — continuing with a" >&2
    echo "  plain project. To retry the scaffold, run it into a clean name:" >&2
    echo "    databricks apps init --version ${APPKIT_VERSION} --package-manager npm --name ${NAME} --output-dir ${PROJECTS}" >&2
    echo "  (it will not write into ${DEST} once that directory exists)" >&2
  else
    SCAFFOLD="complete"
  fi
fi

mkdir -p "$DEST"
cd "$DEST"

if [ ! -e .git ]; then
  git init -q
fi

if [ "$AGENTBRICKS" = "1" ]; then
  # Codex/Omnigent can run with an isolated CODEX_HOME in a git worktree.
  # Commit this project's CLI skill so those workers retain the full workflow.
  PROJECT_SKILL=".agents/skills/workshop-agent-bricks-cli"
  if [ ! -f "$PROJECT_SKILL/SKILL.md" ]; then
    SKILL_SOURCE="$HOME/.claude/skills/workshop-agent-bricks-cli"
    if [ ! -f "$SKILL_SOURCE/SKILL.md" ]; then
      echo "workshop-init-project: workshop-agent-bricks-cli skill is missing from this harness home" >&2
      exit 1
    fi
    mkdir -p "$PROJECT_SKILL"
    cp -R "$SKILL_SOURCE/." "$PROJECT_SKILL/"
  fi
  mkdir -p .claude/skills
  if [ ! -e .claude/skills/workshop-agent-bricks-cli ]; then
    ln -s ../../.agents/skills/workshop-agent-bricks-cli .claude/skills/workshop-agent-bricks-cli
  fi
  # The upstream Python template ignores .claude; stage only this skill link.
  git add .agents/skills/workshop-agent-bricks-cli
  git add -f .claude/skills/workshop-agent-bricks-cli
fi

# --- Refresh only workshop-managed memory; keep attendee/scaffold notes -------

if [ -f "$TEMPLATE" ]; then
  python3 - "$TEMPLATE" <<'PY'
from pathlib import Path
import os
import tempfile

begin, end = '<!-- workshop-managed:begin -->', '<!-- workshop-managed:end -->'
template = Path(__import__('sys').argv[1]).read_text()
managed = begin + '\n' + template.rstrip() + '\n' + end + '\n'
for name in ('AGENTS.md', 'CLAUDE.md'):
    path = Path(name)
    if path.is_symlink():
        raise SystemExit(f'workshop-init-project: {name} is a symlink; cannot safely refresh it')
    old = path.read_text() if path.exists() else ''
    if begin in old:
        if old.count(begin) != 1 or old.count(end) != 1 or old.index(end) < old.index(begin):
            raise SystemExit(f'workshop-init-project: malformed managed section in {name}; repair its markers and retry')
        before, rest = old.split(begin, 1)
        _, after = rest.split(end, 1)
        new = before + managed.rstrip('\n') + after
    elif '<!-- workshop-project-memory -->' in old:
        # Legacy files had no closing boundary. Retain all content as a quoted
        # reference, never guess which attendee edits belong to the old policy.
        # Known additive notes remain active and verbatim outside the archive.
        boundary = '\n## Notes that were already in this project\n'
        legacy, separator, notes = old.partition(boundary)
        if old.startswith(template):
            new = managed + old[len(template):]
        else:
            new = (managed + '\n## Legacy notes (reference)\n\n'
                   'Previous workshop rules in this quote are retired; the managed section above applies. '
                   'Retain attendee facts and decisions recorded here.\n\n'
                   + ''.join('> ' + line + '\n' for line in legacy.splitlines()))
            if separator:
                new += separator + notes
    else:
        new = managed + ('\n## Notes that were already in this project\n\n' + old if old else '')
    if new != old:
        fd, temporary = tempfile.mkstemp(prefix=f'.{name}.', dir='.')
        try:
            with os.fdopen(fd, 'w') as handle:
                handle.write(new)
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
PY
  git add AGENTS.md CLAUDE.md
fi

# Home skills are unavailable to workers with isolated harness configuration.
# Commit their actual contents in the standard project discovery directory.
# Track ownership so future workshop releases can retire only their own copies.
python3 - <<'PY'
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess

source = Path.home() / '.claude/skills'
manifest = Path('.agents/workshop-skills.json')
previous = json.loads(manifest.read_text()) if manifest.is_file() else {'skills': {}, 'retired': []}
if not isinstance(previous.get('skills'), dict) or any(
    not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,127}', name) for name in previous['skills']
):
    raise SystemExit('workshop-init-project: invalid managed-skills manifest; repair it and retry')
current = {}

def digest(path):
    result = hashlib.sha256()
    for item in sorted(path.rglob('*')):
        if item.is_file():
            result.update(item.relative_to(path).as_posix().encode() + b'\0' + item.read_bytes())
    return result.hexdigest()

for skill in sorted(source.iterdir()) if source.is_dir() else []:
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,127}', skill.name):
        continue
    if not (skill / 'SKILL.md').is_file():
        continue
    target = Path('.agents/skills') / skill.name
    if target.exists() and skill.name not in previous['skills']:
        continue  # an attendee/scaffolder owns this copy
    checksum = digest(skill.resolve())
    if not target.is_dir() or digest(target) != checksum:
        if target.is_symlink():
            raise SystemExit(f'workshop-init-project: managed skill {target} became a symlink; retain it separately and retry')
        if target.exists():
            shutil.rmtree(target)
        shutil.copytree(skill.resolve(), target)
    current[skill.name] = checksum
    link = Path('.claude/skills') / skill.name
    link.parent.mkdir(parents=True, exist_ok=True)
    relative = '../../.agents/skills/' + skill.name
    if not link.exists() and not link.is_symlink():
        link.symlink_to(relative)
    subprocess.run(['git', 'add', '--', str(target)], check=True)
    if link.is_symlink() and os.readlink(link) == relative:
        subprocess.run(['git', 'add', '-f', '--', str(link)], check=True)

retired = sorted(set(previous['skills']) - set(current))
for name in retired:
    target = Path('.agents/skills') / name
    if target.is_dir() and not target.is_symlink():
        shutil.rmtree(target)
    link = Path('.claude/skills') / name
    if link.is_symlink() and os.readlink(link) == '../../.agents/skills/' + name:
        link.unlink()
    for path in (target, link):
        if subprocess.run(['git', 'ls-files', '--error-unmatch', '--', str(path)], capture_output=True).returncode == 0:
            subprocess.run(['git', 'add', '-A', '--', str(path)], check=True)
if current or previous['skills']:
    manifest.parent.mkdir(parents=True, exist_ok=True)
    manifest.write_text(json.dumps({'skills': current, 'retired': retired}, sort_keys=True) + '\n')
    subprocess.run(['git', 'add', '--', str(manifest)], check=True)
PY

# AppKit's root-wide ESLint scan must not lint installed upstream skill code.
# Add a narrow global ignore without changing application rules or skill bytes.
# Commit only a previously clean tracked config; retain attendee edits otherwise.
WORKSHOP_LINT_FILE=$(python3 - <<'PY'
from pathlib import Path
import subprocess

marker = '// workshop-skill-assets: installed tools are not app source'
anchor = 'export default tseslint.config('
if Path('.agents/skills').is_dir():
    for name in ('eslint.config.js', 'eslint.config.mjs'):
        path = Path(name)
        if path.is_symlink() or not path.is_file():
            continue
        original = path.read_text()
        if marker in original or original.count(anchor) != 1:
            break  # preserve the selected configuration
        tracked = subprocess.run(['git', 'ls-files', '--error-unmatch', '--', name],
                                 capture_output=True).returncode == 0
        clean = tracked and subprocess.run(['git', 'diff', '--quiet', 'HEAD', '--', name],
                                           capture_output=True).returncode == 0
        block = (anchor + '\n  ' + marker
                 + "\n  { ignores: ['**/.agents/skills/**', '**/.claude/skills/**'] },")
        path.write_text(original.replace(anchor, block, 1))
        if clean:
            subprocess.run(['git', 'add', '--', name], check=True)
            print(name)
        break
PY
)

# APX's root-wide Python scan also sees installed platform skill examples.
# Exclude only managed skill assets; retain checks for all application code.
WORKSHOP_TYPECHECK_FILE=$(python3 - <<'PY'
from pathlib import Path
import subprocess
import tomllib

path = Path('pyproject.toml')
if Path('.agents/skills').is_dir() and path.is_file() and not path.is_symlink():
    original = path.read_text()
    tool = tomllib.loads(original).get('tool', {})
    if 'apx' in tool and 'src' not in tool.get('ty', {}):
        tracked = subprocess.run(['git', 'ls-files', '--error-unmatch', '--', str(path)],
                                 capture_output=True).returncode == 0
        clean = tracked and subprocess.run(['git', 'diff', '--quiet', 'HEAD', '--', str(path)],
                                           capture_output=True).returncode == 0
        path.write_text(original.rstrip() + '\n\n[tool.ty.src]\n'
                        '# Installed workshop skills are tools, not application source.\n'
                        'exclude = [".agents/skills/**", ".claude/skills/**"]\n')
        if clean:
            subprocess.run(['git', 'add', '--', str(path)], check=True)
            print(str(path))
PY
)

# A README, always: purpose and live URL here, followed by the continuity brief
# below. It is the attendee's take-home reminder once the workspace is torn down.
# Preserve scaffold and attendee content; append the missing prompts and brief.
if [ ! -f README.md ]; then
  cat > README.md <<EOF
# ${NAME}

_What this is for:_ (one line — the agent fills this in as soon as it knows)

_Live URL:_ (added once the app is deployed)
EOF
elif ! grep -q "_Live URL:_" README.md 2>/dev/null; then
  cat >> README.md <<'EOF'

_What this is for:_ (one line — the agent fills this in as soon as it knows)

_Live URL:_ (added once the app is deployed)
EOF
fi

# A compact continuity note, filled by the agent from the conversation. Keep
# existing attendee content and never replace a brief on helper reruns.
if ! grep -q '<!-- workshop-brief:v1 -->' README.md; then
  cat >> README.md <<'EOF'

<!-- workshop-brief:v1 -->
## Workshop brief

- Original request: (fill from the attendee's words)
- First version and primary action: (fill as the task becomes known)
- Stated facts: (reuse what the attendee supplied)
- Demo assumptions: (label sample data, integration and storage defaults)
- Checks: (observed results and anything still unverified)
<!-- /workshop-brief -->
EOF
fi

git add README.md
# Commit only workshop setup, retaining unrelated attendee changes in the index.
MEMORY_FILES=(README.md)
if [ -n "$WORKSHOP_LINT_FILE" ]; then
  MEMORY_FILES+=("$WORKSHOP_LINT_FILE")
fi
if [ -n "$WORKSHOP_TYPECHECK_FILE" ]; then
  MEMORY_FILES+=("$WORKSHOP_TYPECHECK_FILE")
fi
if [ -f "$TEMPLATE" ]; then
  MEMORY_FILES+=(AGENTS.md CLAUDE.md)
fi
if [ "$AGENTBRICKS" = "1" ]; then
  MEMORY_FILES+=(.agents/skills/workshop-agent-bricks-cli .claude/skills/workshop-agent-bricks-cli)
fi
if [ -f .agents/workshop-skills.json ]; then
  MEMORY_FILES+=(.agents/workshop-skills.json)
  while IFS= read -r SKILL; do
    for SKILL_PATH in ".agents/skills/$SKILL" ".claude/skills/$SKILL"; do
      if git ls-files --error-unmatch -- "$SKILL_PATH" >/dev/null 2>&1; then
        MEMORY_FILES+=("$SKILL_PATH")
      fi
    done
  done < <(python3 -c 'import json; d=json.load(open(".agents/workshop-skills.json")); print("\n".join(sorted(set(d["skills"]) | set(d["retired"]))))')
fi
if [ "$CREATED" = "1" ]; then
  # Everything in a fresh scaffold belongs to this invocation. Workers need
  # its source/config as well as the policy. Adoption never stages other files.
  git add -A
  while IFS= read -r -d '' CREATED_FILE; do
    MEMORY_FILES+=("$CREATED_FILE")
  done < <(git ls-files -z)
fi
COMMIT="up_to_date"
if ! git diff --cached --quiet -- "${MEMORY_FILES[@]}"; then
  if git commit -q --only -m "Workshop bootstrap: refresh project memory and README" -- "${MEMORY_FILES[@]}" >&2; then
    COMMIT="complete"
  else
    COMMIT="failed"
    echo "workshop-init-project: memory is written but NOT committed; isolated worktree workers cannot inherit it yet. Fix the git error and rerun this helper." >&2
  fi
fi

# The status is local state, never part of the attendee's project commit.
mkdir -p .workshop
EXCLUDE="$(git rev-parse --git-path info/exclude)"
if ! grep -q '^/.workshop/preparation.json$' "$EXCLUDE" 2>/dev/null; then
  mkdir -p "$(dirname "$EXCLUDE")"
  printf '\n/.workshop/preparation.json\n' >> "$EXCLUDE"
fi
python3 - "$DEST" "$SCAFFOLD" "$COMMIT" "$TEMPLATE" "$JSON" <<'PY'
import json
import os
from pathlib import Path
import sys
import tempfile

dest, scaffold, commit, template, json_mode = sys.argv[1:]
memory = 'complete' if Path(template).is_file() else 'missing'
ready = scaffold != 'failed' and commit != 'failed' and memory == 'complete'
status = dict(project_path=dest, ready=ready, scaffold=scaffold, memory=memory, commit=commit)
fd, temporary = tempfile.mkstemp(prefix='.preparation.', dir='.workshop')
with os.fdopen(fd, 'w') as handle:
    json.dump(status, handle)
os.replace(temporary, '.workshop/preparation.json')
if memory == 'missing':
    print('workshop-init-project: workshop template is missing; project created without workshop memory. Reopen a harness to repair preparation, then rerun.', file=sys.stderr)
if json_mode == '1':
    print(json.dumps(status))
    sys.exit(0 if ready else 1)
print(dest)
PY

# Default stdout remains exclusively the usable project path.
