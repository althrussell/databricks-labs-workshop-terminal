{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Default Workshop Design Studio release gate. Tune per project, but do not weaken accessibility blockers.",
  "max_findings": {
    "critical": 0,
    "high": 2,
    "medium": 12
  },
  "blocked_codes": [
    "IMG_ALT",
    "NO_FOCUS",
    "NO_REDUCED_MOTION",
    "FIXED_WIDTH"
  ],
  "check_contrast": true,
  "minimum_contrast": 4.5
}
